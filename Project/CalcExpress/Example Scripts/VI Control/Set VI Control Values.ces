/* Build VI path */
viName = "ISP Exmpl - Controls Container.vi";
viPath = FileBuildPath(FileGetAppPath(9),"CSE_ISP.llb",viName);
//probe(viPath);

/* Start VI */
viRun(viPath);
//viOpenFP(viPath);

/* Set VI control values */
viCtrlSet(viName, "DBL", 123.456);
viCtrlSet(viName, "CDB", complex(12.3,-1.23));
viCtrlSet(viName, "STR", "String value");

viCtrlSet(viName, "BOOL", 1);
viCtrlSet(viName, "RING", 2);
viCtrlSet(viName, "ENUM", 3);
viCtrlSet(viName, "PATH", viPath);

viCtrlSet(viName, "A1DBL", vector(-1,-2,-3));

//viAbort(viName);

return;
