/* create variables */
dbl   = 3.1415;
a1dbl = vector(dbl, dbl+1, dbl+2, dbl+3, dbl+4);
a2dbl = matrix(a1dbl, a1dbl+10, a1dbl+20);
cdb   = complex(2,5);
a1cdb = vector(cdb, cdb+1, cdb+2, cdb+3, cdb+4);
a2cdb = matrix(a1cdb, a1cdb+10, a1cdb+20);
str   = "hello world!!!";
a1str = vector("cell0", "cell1", "cell2", "cell3", "cell4");
a2str = matrix(smix("row0:",a1str), smix("row1:",a1str), smix("row2:",a1str));

/* array of the variable names */
varnames = vector("dbl","a1dbl","a2dbl","cdb","a1cdb","a2cdb","str","a1str","a2str");

/* attach history */
for (i=0; i < size(varnames); i++) {
  vhAttach( varnames[i], 100 );
}

/* update variable values (new values are added to the history */
for (i=0; i < size(varnames); i++) {
  // ### add the curect variable value to the history
  idn(varnames[i]) = idn(varnames[i]);
  // ### add more values
  datatype = vtest(varnames[i]);  // get the data type of a variable
  if ((datatype == 1) || (datatype == 3) || (datatype == 4)) {
    // *** DBL or an array thereof
    idn(varnames[i])++; idn(varnames[i]) *= 2; ++idn(varnames[i]);
  }
  else if ((datatype == 5) || (datatype == 6) || (datatype == 7)) {
    // *** CDB or an array thereof
    idn(varnames[i]) += 1; idn(varnames[i]) *= 2; idn(varnames[i]) += 1;
  }
  else if ((datatype == 0) || (datatype == 8) || (datatype == 9)) {
    // *** String or an array thereof
    idn(varnames[i]) = smix(idn(varnames[i]), "_s1");
    idn(varnames[i]) = smix(idn(varnames[i]), "_s2");
  }
}

/* display histories */
for (i=0; i < size(varnames); i++) {
  vhShow(varnames[i], scat("History of ", supr(varnames[i])));
}
return;
