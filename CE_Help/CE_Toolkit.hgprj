  <MasterRule>
    <Property Name="Build_Root_Dir">html</Property>
    <Property Name="BuildHelp">Enable</Property>
    <Property Name="VIDscrMode">Description1</Property>
    <Property Name="MenuDscrMode">Description</Property>
    <Property Name="MenuItemIcons">Enable</Property>
    <Property Name="Ctl_DscrMode">Description</Property>
    <Property Name="Ctl_ClustMembers">Enable</Property>
    <Property Name="Ctl_EnumValues">Enable</Property>
    <Property Name="PVIIDscrMode">None</Property>
    <Property Name="VIDetailsMode">None</Property>
    <Property Name="ProductInfoMode">Disable</Property>
    <Property Name="Source_Paths.VI_Template">html_source\Template\CETK Help Template - VI.html</Property>
    <Property Name="Source_Paths.Menu_Template">html_source\Template\CETK Help Template - Menu.html</Property>
    <Property Name="Source_Paths.PolyVI_Template">html_source\Template\CETK Help Template - PolyVI.html</Property>
    <Property Name="Target_Paths.HTML_Dir">.</Property>
    <Property Name="Target_Paths.Image_Dir">image_vis</Property>
    <Property Name="Target_Paths.CSS_Dir">css</Property>
    <Property Name="Target_Paths.JS_Dir">js</Property>
    <Property Name="Source_Paths.CSS_Files">
      <Item>html_source\css\cetk.css</Item>
    </Property>
    <Property Name="Source_Paths.JS_Files">
      <Item>html_source\js\vih_frames.js</Item>
      <Item>html_source\js\vih_print.js</Item>
      <Item>html_source\js\vih_select.js</Item>
    </Property>
    <Property Name="Control_Rules">
      <Item>
        <Property Name="CtrlID">error in (no error)</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">describes error conditions that occur before this VI runs. This input provides &lt;B&gt;standard error in&lt;/B&gt; functionality.</Property>
        <Property Name="CustomName">error in</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error in</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">describes error conditions that occur before this VI runs. This input provides &lt;B&gt;standard error in&lt;/B&gt; functionality.</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error out</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">contains error information. This output provides &lt;B&gt;standard error out&lt;/B&gt; functionality. </Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error in.status</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">indicates error status.</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error in.code</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">contains error code.</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error in.source</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">contains additional error information.</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error out.status</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">indicates error status.</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error out.code</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">contains error code.</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error out.source</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">contains additional error information.</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">VC Handle</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">is a reference number used to access variables in a Variable Context and manipulate its properties. Use &lt;a href="hprj:VM - Open Context.vi"&gt;VM - Open Context.vi&lt;/a&gt; to create a variable context and obtain its handle.</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">dup VC Handle</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;VC Handle&lt;/b&gt;.</Property>
      </Item>
    </Property>
  </MasterRule>

  <ItemRules>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\dir.mnu">
      <Property Name="BuildHelp">Enable</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Open Context.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Creates a new local Variable Context. The VI returns the handle of the context, which is used to refer to that context and access its variables. Each opened context must be closed when it is no longer needed. Use &lt;a href="hprj:VM - Close Context.vi"&gt;VM - Close Context.vi&lt;/a&gt; to close a context.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI saves information on a creator of the context and a specifier of intended lifetime of the context. This information can help to search for loose contexts. Use &lt;a href="hprj:VM - Close loose contexts.vi"&gt;VM - Close loose contexts.vi&lt;/a&gt; to look for loose contexts and close them. However, it cannot guarantee that all actually loose contexts are closed. Good practice is to explicitly close contexts.\n\nAlso see &lt;a href="hprj:varman.html"&gt;VarMan overview&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">Creator (top-level VI)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is an optional parameter. It specifies a name of the context creator. If it contains an empty string (by default), the VI assumes that creator is the VI in the top of hierarchy it is called. The creator name is constant during the context lifetime.\nUse &lt;a href="hprj:VM - Context Info.vi"&gt;VM - Context Info.vi&lt;/a&gt; in order to obtain a name of the context creator.\nUse &lt;a href="hprj:VM - Get list of contexts.vi"&gt;VM - Get list of contexts.vi&lt;/a&gt; in order to obtain handles of contexts that belong to the specified creator.\n</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">context life time</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is an optional parameter. It specifies intended lifetime of the context. This parameter together with the &lt;b&gt;Creator&lt;/b&gt; defines a condition that the context is under operation (not loose). </Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="creator run top level">The context is under operation while its creator is running as top-level VI. This is the default value.</EnumValue>
            <EnumValue ID="1" STR="creator running ">The context is under operation while its creator belongs to any running hierarchy.</EnumValue>
            <EnumValue ID="2" STR="creator in memory">The context is under operation while its creator belongs to any running hierarchy.</EnumValue>
            <EnumValue ID="3" STR="untill closed">The context is permanently under operation until it is closed.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">close loose contexts (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is an optional parameter. If it is TRUE, the VI calls &lt;a href="hprj:VM - Close loose contexts.vi"&gt;VM - Close loose contexts.vi&lt;/a&gt; in order to find and close loose contexts. Default value is FALSE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VC Handle out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the handle of the opened Variable Context.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Close Context.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Closes a local Variable Context. When a context is closed, all variables residing in it and all aliases associated with those variables are destroyed.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a handle of variable context is to be closed.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Not a VC Handle.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Validates the handle of a Variable Context.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a handle of local context to validate.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Not a VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if &lt;b&gt;VC Handle&lt;/b&gt; is not valid handle of a variable context.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Arbitrary Data.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of an arbitrary data type; both &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;predefined&lt;/a&gt; and &lt;a href="hprj:dtypes.html#data_types_user_defined"&gt;user-defined&lt;/a&gt; data types are supported.  (*) This legacy VI has a modern successor: &lt;a href="hprj:VM3 - Arbitrary Data.vi"&gt;VM3 - Arbitrary Data.vi&lt;/a&gt;</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI accepts and returns variable values in the Flattened-To-String format, with the exception of the String type, whose values are passed as native LabVIEW strings. For predefined data types, the VI checks the consistency of the data type code and value format, and it returns an error in case of a mismatch.\n\nAlso see &lt;a href="hprj:varman.html"&gt;VarMan overview&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">flattened value</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a value to be assigned to a variable if either &lt;i&gt;create&lt;/i&gt; or &lt;i&gt;set value&lt;/i&gt; operation is to be performed. A value must be represented in the Flattened-To-String format unless the variable has the String data type (type code is 0), in which case the value must be represented as a native LabVIEW string.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">flattened value out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the value of the specified variable if &lt;i&gt;get value&lt;/i&gt; operation was performed; otherwise, it returns the same value as &lt;b&gt;flattened value in&lt;/b&gt;. A returned variable value is represented in the Flattened-To-String format unless the variable has the String data type (type code is 0), in which case the value is represented as a native LabVIEW string.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">var type</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a code of variable datatype. This code is required to perform all operations except of destroying variable. The VI returns an error if an actual variable datatype is different from &lt;b&gt;var type&lt;/b&gt;. To manage variables of user-defined data types a type code should be in one of the following ranges: from 128 up to 249, or from 1000 up to 9999. By default, &lt;b&gt;var type&lt;/b&gt; is equal to 128.\n&lt;u&gt;&lt;b&gt;Exception&lt;/b&gt;&lt;/u&gt;. You can pass -1 to &lt;b&gt;var type&lt;/b&gt; if &lt;b&gt;cmd&lt;/b&gt; is &lt;i&gt;get value&lt;/i&gt;. In this case, the VI returns a variable value without paying attention to a variable datatype; herewith, &lt;b&gt;var type out&lt;/b&gt; indicator contains an actual code of the variable datatype.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">var type out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the same value as &lt;b&gt;var type&lt;/b&gt; unless &lt;i&gt;get value&lt;/i&gt; operation has been performed and &lt;b&gt;var type&lt;/b&gt; equals -1, in which case &lt;b&gt;var type out&lt;/b&gt; returns code of the actual variable datatype.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - DBL Scalar.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;DBL Number&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. (*) This legacy VI has a modern successor: &lt;a href="hprj:VM3 - DBL Scalar.vi"&gt;VM3 - DBL Scalar.vi&lt;/a&gt;</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 1D Array of CDB.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;1D Array of CDB&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. (*) This legacy VI has a modern successor: &lt;a href="hprj:VM3 - 1D Array of CDB.vi"&gt;VM3 - 1D Array of CDB.vi&lt;/a&gt;</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 1D Array of DBL.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;1D Array of DBL&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. (*) This legacy VI has a modern successor: &lt;a href="hprj:VM3 - 1D Array of DBL.vi"&gt;VM3 - 1D Array of DBL.vi&lt;/a&gt;</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 1D Array of Strings.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;1D Array of Strings&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. (*) This legacy VI has a modern successor: &lt;a href="hprj:VM3 - 1D Array of Strings.vi"&gt;VM3 - 1D Array of Strings.vi&lt;/a&gt;</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 2D Array of CDB.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;2D Array of CDB&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. (*) This legacy VI has a modern successor: &lt;a href="hprj:VM3 - 2D Array of CDB.vi"&gt;VM3 - 2D Array of CDB.vi&lt;/a&gt;</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 2D Array of DBL.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;2D Array of DBL&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. (*) This legacy VI has a modern successor: &lt;a href="hprj:VM3 - 2D Array of DBL.vi"&gt;VM3 - 2D Array of DBL.vi&lt;/a&gt;</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 2D Array of Strings.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;2D Array of Strings&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. (*) This legacy VI has a modern successor: &lt;a href="hprj:VM3 - 2D Array of Strings.vi"&gt;VM3 - 2D Array of Strings.vi&lt;/a&gt;</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - CDB Scalar.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;CDB Number&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. (*) This legacy VI has a modern successor: &lt;a href="hprj:VM3 - CDB Scalar.vi"&gt;VM3 - CDB Scalar.vi&lt;/a&gt;</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Strings.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;String&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. (*) This legacy VI has a modern successor: &lt;a href="hprj:VM3 - String.vi"&gt;VM3 - String.vi&lt;/a&gt;</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Destroy Variable.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Destroys variables of any data type. Note that a variable is automatically destroyed when the Variable Context in which it resides is closed.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">control has to contain a handle of the variable context where a desired variable resides. &lt;b&gt;VC Handle&lt;/b&gt; value is ignored if either &lt;b&gt;name_spec&lt;/b&gt; refers to a variable by an alias or &lt;b&gt;global&lt;/b&gt; is TRUE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">global ? (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">control. If it equals FALSE (by default), a local variable is to be destroyed; If it equals TRUE, a global variable is to be destroyed.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Type Code to CalcExpress Data Type.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Converts a numeric data type code to CalcExpress Data Type enum.\nSee &lt;a href="hprj:dtypes.html"&gt;Data types&lt;/a&gt; topic for details.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">type code (1)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is VarMan data type code.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">CalcExpress Data Type</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns Enum with predefined data types:</Property>
          <Property Name="EnumValues">Enable</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="String"/>
            <EnumValue ID="1" STR="DBL Number"/>
            <EnumValue ID="2" STR="identifier"/>
            <EnumValue ID="3" STR="1D Array of DBL"/>
            <EnumValue ID="4" STR="2D Array of DBL"/>
            <EnumValue ID="5" STR="CDB Number"/>
            <EnumValue ID="6" STR="1D Array of CDB"/>
            <EnumValue ID="7" STR="2D Array of CDB"/>
            <EnumValue ID="8" STR="1D Array of String"/>
            <EnumValue ID="9" STR="2D Array of String"/>
            <EnumValue ID="10" STR="Unknown data type"/>
          </Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Get list of contexts.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns the handles of either all local Variable Contexts or only those contexts belonging to the specified creator.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">Creator (all contexts)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is optional parameter. If empty string (by default), the VI returns handles of all opened variable contexts. Otherwise, the VI returns handles of contexts that belong to the specified &lt;b&gt;Creator&lt;/b&gt;. See &lt;a href="hprj:VM - Open Context.vi"&gt;VM - Open Context.vi&lt;/a&gt; for details.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - List of Variables.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns information about all variables existing in the specified Variable Context.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a handle of the variable context. In order to get list of global variables, pass value of -1 to &lt;b&gt;VC Handle&lt;/b&gt; or keep it unwired.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">sort</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a variable property is to be used to sort &lt;b&gt;variables info&lt;/b&gt; array :</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="don't sort">Default value</EnumValue>
            <EnumValue ID="1" STR="name"/>
            <EnumValue ID="2" STR="alias"/>
            <EnumValue ID="3" STR="type"/>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">reverse? (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If it is equal to TRUE, VI sorts the output list in reversed order. By default, it is equal to FALSE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">variables info</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicator is an array of clusters that contains information on all variables residing in the given context. An element of the array is a cluster that has the following members:</Property>
          <Property Name="ClusterMembers">Enable</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">variables info..name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">of the variable.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">variables info..type</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is &lt;a href="hprj:dtypes.html"&gt;data type&lt;/a&gt; of the variable.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">variables info..alias</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is an aliad associated with the variable.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">variables info..history</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">equals TRUE if variable has a history.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - List of Aliases.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns information about all aliases and the associated variables.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">sort</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a property is to be used to sort &lt;b&gt;alias info&lt;/b&gt; array :</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="don't sort">Default value</EnumValue>
            <EnumValue ID="1" STR="alias"/>
            <EnumValue ID="2" STR="vc handle"/>
            <EnumValue ID="3" STR="name"/>
            <EnumValue ID="4" STR="type"/>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">reverse? (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If it is equal to TRUE, VI sorts the output list in reversed order. By default, it is equal to FALSE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">aliases info</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is an array of clusters that contains information on all aliases and associated variables. An element of the array is a cluster that has the following members:</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">aliases info..alias</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is alias name.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">aliases info..vc handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains a handle of variable context where a variable associated with the &lt;b&gt;alias&lt;/b&gt; resides.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">aliases info..var name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a name of the variable associated with the &lt;b&gt;alias&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">aliases info..type</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a code of the variable &lt;a href="hprj:dtypes.html"&gt;data type&lt;/a&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">aliases info..history</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">equals TRUE if the variable has a history attached.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Alias Controller.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Controls the association of an alias with a variable. This VI can be used to associate an alias with a variable, rename an alias, or disassociate a variable from an alias. Note that an alias can be immediately associated with a variable when the variable is created. (see the &lt;a href="hprj:varman_vref.html"&gt;Referring to variables&lt;/a&gt; topic).</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the handle of the variable context where a desired variable resides. To refer to a global variable, pass value of -1 to &lt;b&gt;VC Handle&lt;/b&gt; or keep it unwired. &lt;b&gt;VC Handle&lt;/b&gt; is ignored if &lt;b&gt;name_spec&lt;/b&gt; refers to a variable by an alias.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">action</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the operation to perform:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="nop">do nothing (default).</EnumValue>
            <EnumValue ID="1" STR="create">VI creates an alias (&lt;b&gt;alias&lt;/b&gt; control) and associates it with a variable specified in &lt;b&gt;name_spec&lt;/b&gt;. If the variable already has an alias associated, the VI returns an error.</EnumValue>
            <EnumValue ID="2" STR="create or rename">If a variable specified in &lt;b&gt;name_spec&lt;/b&gt; doesn't have an alias associated with it, VI creates an alias (&lt;b&gt;alias&lt;/b&gt; control) and associates it with the variable. If the variable already has an alias associated, VI renames the alias.</EnumValue>
            <EnumValue ID="3" STR="dispose">VI makes the variable specified in &lt;b&gt;name_spec&lt;/b&gt; unassociated with an alias.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">alias</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an alias name if &lt;b&gt;action&lt;/b&gt; is either &lt;i&gt;create&lt;/i&gt; or &lt;i&gt;create or rename&lt;/i&gt;.\nIMPORTANT: In difference with a general format of a name specifier, you should not insert the equality mark before an alias name here. If the first character in &lt;b&gt;alias&lt;/b&gt; is equality mark, it is considered as a part of an alias name.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dup alias</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;alias&lt;/b&gt;.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Variable Attribute.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Reads or writes a variable attribute. An attribute is arbitrary data is to be associated with the variable. An attribute is stored as a string; if other data type is desired for attribute, use any method to convert it to/from string.\nAlso see &lt;a href="hprj:varman.html"&gt;VarMan overview&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a handle of the variable context where a desired variable resides. In order to refer to a global variable, pass value of -1 to &lt;b&gt;VC Handle&lt;/b&gt; or keep it unwired. &lt;b&gt;VC Handle&lt;/b&gt; is ignored if &lt;b&gt;name_spec&lt;/b&gt; refers to a variable by an alias.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">cmd (read)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the operation to perform:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="read">read attribute (by default).</EnumValue>
            <EnumValue ID="1" STR="write">write attribute.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Attribute in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">Pass a value is to be written to the variable attribute.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Attribute out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a value of the variable attribute when reading operation is performed. If the variable has no attribute associated, it returns an empty string (no errorin this case).</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">DBL value</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a value of the given variable if it has &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;DBL Scalar&lt;/a&gt; data type and reading operation has been performed.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">type code</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a &lt;a href="hprj:dtypes.html"&gt;data type&lt;/a&gt; of the specified variable.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">writer ID</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; for the current variable value.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Variable Info.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns information about the specified variable. If an alias is used to refer to a variable, VI returns actual properties of a variable associated with the alias.\nAlso see &lt;a href="hprj:varman.html"&gt;VarMan overview&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a handle of the variable context where a desired variable resides. In order to get information on a global variable, pass value of -1 to &lt;b&gt;VC Handle&lt;/b&gt; or keep it unwired. &lt;b&gt;VC Handle&lt;/b&gt; is ignored if &lt;b&gt;name_spec&lt;/b&gt; refers to a variable by an alias.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">var VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a handle of context where the specified variable resides. It can differ from &lt;b&gt;VC Handle&lt;/b&gt;, if &lt;b&gt;name_spec&lt;/b&gt; refers to a variable by an alias.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">var name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns an actual name of the specified variable.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">alias</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns an alias associated with the specified variable or empty string if the variable doesn't have an alias.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">var type</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the &lt;a href="hprj:dtypes.html"&gt;data type&lt;/a&gt; of the specified variable.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">has history</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if the specified variable has a history attached.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Context Info.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns information on the specified Variable Context.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a handle of variable context to operate. In order to specify the global context, pass -1 to it.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">context life time</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a value specified as a context life time when context has been opened (see &lt;a href="hprj:VM - Open Context.vi"&gt;VM - Open Context.vi&lt;/a&gt;).</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="creator run top level"/>
            <EnumValue ID="1" STR="creator running "/>
            <EnumValue ID="2" STR="creator in memory"/>
            <EnumValue ID="3" STR="untill closed"/>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VC Name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a name of the context if it has one assigned; otherwise, it contains an empty string.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Creator</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a name of the context creator (see &lt;a href="hprj:VM - Open Context.vi"&gt;VM - Open Context.vi&lt;/a&gt;).</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Close loose contexts.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Searches for loose contexts and closes any found.\n\n</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI examines a context for being loose by the following way:\nThe VI retrieves Creator and context life time attributes specified when the context was created (see &lt;a href="hprj:VM - Open Context.vi"&gt;VM - Open Context.vi&lt;/a&gt;). Then it opens a reference to the VI specified by Creator and acquires its state. The VI assumes the context is loose if the creator VI is not in a state compatible with context life time.\n\nNote that this technique cannot guarantee that all actually loose contexts are closed. Good practice is to explicitly close contexts. Use &lt;a href="hprj:VM - Close Context.vi"&gt;VM - Close Context.v&lt;/a&gt;i to close a context.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC handles (all)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is optional parameter that specifies handles of variable contexts that need to be examined. If it is an empty array (by default), the VI examines all opened local contexts and closes ones that meet "context is loose" condition.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">num of closed</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns number of closed contexts.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Context Names.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages Variable Context names. This VI can be used to assign or reassign a name to a context, retrieve the name assigned to a context, or locate the context handle associated with a given name.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a handle of opened local context if you need either assign or obtain a name of the context. Pass -1 if you need obtain a name of the global context.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VC Name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">defines a name is to be assigned to the context. A context name may consist of any printable characters including a space mark ('\\s') providing that the first character is not a space mark. VarMan doesn't allow names to include characters with codes less than 32. If you assign a name to a context, the name must be unique. The VI returns an error if you try to assign invalid name to a context or there is a context that has the same name.\nIn addition, this parameter is used to find a context handle if its name is known.\n</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">action</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an operation that is to be executed:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="nothing">does nothing.</EnumValue>
            <EnumValue ID="1" STR="reset">cancels all name assignments.</EnumValue>
            <EnumValue ID="2" STR="assign name">assigns &lt;b&gt;VC Name&lt;/b&gt; to the context specified by &lt;b&gt;VC Handle&lt;/b&gt;.</EnumValue>
            <EnumValue ID="3" STR="get name">returns a name assigned to the context specified by &lt;b&gt;VC Handle&lt;/b&gt;.</EnumValue>
            <EnumValue ID="4" STR="get handle">returns a a handle of the context that has given &lt;b&gt;VC Name&lt;/b&gt;.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VC Handle out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If &lt;b&gt;action&lt;/b&gt; is &lt;i&gt;get handle&lt;/i&gt;, it returns handle of the variable context with name equal to &lt;b&gt;VC Name&lt;/b&gt; (if no one context has the given name, the VI returns an error). For other values of &lt;b&gt;action&lt;/b&gt;, &lt;b&gt;VC Handle out&lt;/b&gt; duplicates &lt;b&gt;VC Handle&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VC Name out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If &lt;b&gt;action&lt;/b&gt; is &lt;i&gt;get name&lt;/i&gt;, it returns a name previously assigned to the context specified by &lt;b&gt;VC Handle&lt;/b&gt; (VI returns an error if there is no name assigned to the context). For other values of &lt;b&gt;action&lt;/b&gt;, &lt;b&gt;VC Name out&lt;/b&gt; duplicates &lt;b&gt;VC Name&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error code</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a value identifying an error: </Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="no error">successfully completed.</EnumValue>
            <EnumValue ID="1" STR="wrong name">name contains characters with codes less than 32 or the first character is a space mark.</EnumValue>
            <EnumValue ID="2" STR="name not found">there is no a context that has the specified name.</EnumValue>
            <EnumValue ID="3" STR="non-unique name">an attempt to assign the name that is already assigned to another context.</EnumValue>
            <EnumValue ID="4" STR="invalid handle">the specified handle doesn't refer to any context.</EnumValue>
            <EnumValue ID="5" STR="unknown error"/>
          </Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Initializing.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Initializes &lt;a href="hprj:varman.html"&gt;VarMan&lt;/a&gt;. After this VI completes, all local and global variables are destroyed, and all local contexts are closed.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - History Controller.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages the history of variables. The specified variable must exist; otherwise, the VI returns an error.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable History&lt;/a&gt; and &lt;a href="hprj:varman.html"&gt;VarMan overview&lt;/a&gt; topics for more information.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">history length</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the maximum number of values that can be stored in a variable history. A history is maintained like a circular buffer. It always contains the newest values; number of the values is limited to &lt;b&gt;history length&lt;/b&gt;.This parameter is only used if VI creates a new history (&lt;b&gt;cmd&lt;/b&gt; control is equal to &lt;i&gt;create&lt;/i&gt;), it is ignored in other cases. If &lt;b&gt;history length&lt;/b&gt; is less than or equal to zero, the VI returns an error. Keep in mind that large value of history length might cause a huge memory use, it is especially actual if a variable is an array.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">cmd (nop:default)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the operation to perform:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="nop">VI does nothing. It's default value.</EnumValue>
            <EnumValue ID="1" STR="create">VI creates a history and attaches it to the specified variable.</EnumValue>
            <EnumValue ID="2" STR="destroy">VI destroys a history of the specified variable.</EnumValue>
            <EnumValue ID="3" STR="reset">VI resets a history of the specified variable (makes it empty).</EnumValue>
            <EnumValue ID="4" STR="get info">VI returns information about configuration and state of the variable history in the &lt;b&gt;history info&lt;/b&gt; indicator.</EnumValue>
            <EnumValue ID="5" STR="config">VI saves new parameters of &lt;b&gt;time conditions&lt;/b&gt; and &lt;b&gt;value condition&lt;/b&gt; into the configuration of the variable history.</EnumValue>
            <EnumValue ID="6" STR="create_wrid">VI creates a history, which maintains &lt;a href="varman.html#varman_overview_wrid"&gt;Writer IDs&lt;/a&gt;, and attaches it to the specified variable.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">time conditions</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is an optional control to specify time conditions used to maintain the variable history. See the &lt;a href="hprj:varman_vhist.html#vhistory_overview_update_tc"&gt;Updating history, Time conditions&lt;/a&gt; topic for details on how it works.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">time conditions.Step, ms</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a time step, in milliseconds, to update the history.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">time conditions.Gate, ms</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a time gate, in milliseconds, to overwrite the last value in the history.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">value condition</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is an optional control to specify a value condition used to maintain the variable history. Note that value condition is evaluated if only the &lt;b&gt;time step&lt;/b&gt; condition is not met. See &lt;a href="hprj:varman_vhist.html#vhistory_overview_update_vc"&gt;Updating history, Value conditions&lt;/a&gt; topic for details on how it works.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">value condition.condition</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the kind of condition:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="don't test">there is no a value condition.</EnumValue>
            <EnumValue ID="1" STR="changed">a new variable value is not equal to the last value.</EnumValue>
            <EnumValue ID="2" STR="abs deviation">an absolute value of deviation of new value from the last value is greater than or equal to &lt;b&gt;Delta&lt;/b&gt;.</EnumValue>
            <EnumValue ID="3" STR="rel deviation">an absolute value of deviation of new value from the last value is greater than or equal to the last value multiplied by &lt;b&gt;Delta&lt;/b&gt;.</EnumValue>
            <EnumValue ID="4" STR="out of range">a new variable value is less than or equal to &lt;b&gt;Range_Min&lt;/b&gt;, or greater than or equal to &lt;b&gt;Range_Max&lt;/b&gt;.</EnumValue>
            <EnumValue ID="5" STR="within range">a new variable value is greater than or equal to &lt;b&gt;Range_Min&lt;/b&gt;, and less than or equal to &lt;b&gt;Range_Max&lt;/b&gt;.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">value condition.Delta</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is used as a condition parameter if &lt;b&gt;condition&lt;/b&gt; is either &lt;i&gt;abs deviation&lt;/i&gt; or &lt;i&gt;rel deviation&lt;/i&gt;. If &lt;b&gt;Delta&lt;/b&gt; is negative, the absolute value of it is stored in the history configuration.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">value condition.Range_Min</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the low boundary of a value range if &lt;b&gt;condition&lt;/b&gt; is either &lt;i&gt;out of range&lt;/i&gt; or &lt;i&gt;within range&lt;/i&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">value condition.Range_Max</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the top boundary of a value range if &lt;b&gt;condition&lt;/b&gt; is either &lt;i&gt;out of range&lt;/i&gt; or &lt;i&gt;within range&lt;/i&gt;.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - History Info.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns information on a variable history. The specified variable must exist; otherwise, the VI returns an error. The VI does not return an error if the specified variable has no history attached. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee &lt;a href="hprj:varman_vhist.html"&gt;Variable History&lt;/a&gt; and &lt;a href="hprj:varman.html"&gt;VarMan overview&lt;/a&gt; topics for more information.\n</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">valid history</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is TRUE if the specified variable has a history attached. Otherwise, &lt;b&gt;valid history&lt;/b&gt; is FALSE; herewith &lt;b&gt;error out&lt;/b&gt; does not indicate an error.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get Arbitrary Variable History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns the history of a variable that can have an arbitrary data type; both &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;predefined&lt;/a&gt; and &lt;a href="hprj:dtypes.html#data_types_user_defined"&gt;user-defined&lt;/a&gt; data types are supported. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable History&lt;/a&gt; and &lt;a href="hprj:varman.html"&gt;VarMan Overview&lt;/a&gt; topics for more information.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">history</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is an array containing historic variable values. Values of all data types are presented in the Flattened-To-String format, with the exception of the String data type, whose values are passed as native LabVIEW strings. Elements in both the &lt;b&gt;time stamps&lt;/b&gt; and &lt;b&gt;history&lt;/b&gt; arrays are arranged in the order specified by the &lt;b&gt;reverse order&lt;/b&gt; control.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 1D Array of CDB History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns the history of a variable that has the &lt;b&gt;1D Array of CDB&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 1D Array of DBL History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns the history of a variable that has the &lt;b&gt;1D Array of DBL&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 1D Array of STR History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns the history of a variable that has the &lt;b&gt;1D Array of Strings&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 2D Array of CDB History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns the history of a variable that has the &lt;b&gt;2D Array of CDB&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 2D Array of DBL History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns the history of a variable that has the &lt;b&gt;2D Array of DBL&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 2D Array of STR History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns the history of a variable that has the &lt;b&gt;2D Array of Strings&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get CDB Scalar History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns the history of a variable that has the &lt;b&gt;CDB Number&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get DBL Scalar History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns the history of a variable that has the &lt;b&gt;DBL Number&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get STR History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns the history of a variable that has the &lt;b&gt;String&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Preset CDB Scalar History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Presets history data or appends new data to the current history of a variable that has the &lt;b&gt;CDB Number&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Preset DBL Scalar History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Presets history data or appends new data to the current history of a variable that has the &lt;b&gt;DBL Number&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Preset STR History.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Presets history data or appends new data to the current history of a variable that has the &lt;b&gt;String&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. The specified variable must exist and have a history attached; otherwise, the VI returns an error. The &lt;a href="hprj:VHistory - History Controller.vi"&gt;VHistory - History Controller.vi&lt;/a&gt; is used to configure VarMan to maintain the history of a variable.\nSee the &lt;a href="hprj:varman_vhist.html"&gt;Variable history&lt;/a&gt; topic for more information.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\CE_Math\ce_fitting.llb\[ce] Levenberg Marquardt.vi">
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Abort Evaluation.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI aborts evaluation of a CalcExpress expression/script associated with the given CalcExpress Instance Reference, and makes the evaluating VI to finish.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Close Instance.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI closes a CalcExpress instance context. If the context has been dynamically created by &lt;a href="hprj:[ce] CalcExpress - Parse Script.vi"&gt;CalcExpress - Parse Script.vi&lt;/a&gt;, the VI completely destroys it. If the context is static (i.e. it belongs to a CalcExpress VI instance), the VI reinitializes it with decreasing allocated memory.\n</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">destroyed</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">(if TRUE) indicates that a dynamic instance context has been destroyed.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Not a CE InstanceRef.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI validates a reference to a CalcExpress instance context.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">dynamically opened</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if &lt;b&gt;CE InstanceRef&lt;/b&gt; refers to dynamically created CalcExpress instance context; otherwise, it returrns FALSE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">not a CE Instance</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if &lt;b&gt;CE InstanceRef&lt;/b&gt; is an invalid reference; otherwise, it returns FALSE.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Parse Script.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI parses a &lt;a href="hprj:ce_syntax.html"&gt;CalcExpress&lt;/a&gt; expression/script and returns a reference to a CalcExpress instance context that contains a parsed script. This reference is used to evaluate the script with the help of &lt;a href="hprj:[ce] CalcExpress - Eval Script.vi"&gt;[ce] CalcExpress - Eval Script.vi&lt;/a&gt;. In addition, the VI can load &lt;a href="hprj:ce_functions.html#ce_func_implementation_funcvi"&gt;FuncVIs&lt;/a&gt; required to evaluate the script.\n</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is reentrant, every instance of the VI has its own context to store a script parsed last (called static context). In addition, you can make the VI create a dynamical instance context if a single VI instance has to produce a few parsed scripts; e.g. within a loop. Note that each dynamic context is unique in difference from the static context. A dynamic context should be explicitly closed with the help of &lt;a href="hprj:[ce] CalcExpress - Close Instance.vi"&gt;[ce] CalcExpress - Close Instane.vi&lt;/a&gt;. Furthermore, all dynamicaly opened contexts will be implicitly closed when this VI is unloaded; i.e. no its instance stay in memory.\n</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">load FuncVIs</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a method to load &lt;a href="hprj:ce_functions.html#ce_func_implementation_funcvi"&gt;FuncVIs&lt;/a&gt;. Make the VI load FuncVIs if a script can contain calls of FuncVI functions; it has two advantages. First, CalcExpress can detect an invalid function call while parsing but not evaluating. Second, CalcExpress will be able to evaluate a script much faster if all required FuncVIs are preliminary loaded.</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="don't load">The VI doesn't load FuncVIs.</EnumValue>
            <EnumValue ID="1" STR="load">The VI loads FuncVIs of the functions that are not recognized as embedded (FastFunc) functions.</EnumValue>
            <EnumValue ID="2" STR="load &amp; test">The VI loads FuncVIs as described above. In addition, the VI verifies calls of FuncVI functions for correct number of parameters. The VI returns an error if any mismatch found.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">create instance</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a location to store the parsed script. If it is equal to FALSE, the VI places the parsed script within the static VI instance context. If &lt;b&gt;create instance&lt;/b&gt; equals TRUE, the VI creates new dynamic CalcExpress instance context, and stores the parsed script within it.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">CE InstanceRef</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a reference to CalcExpress instance context containing the parsed script. &lt;b&gt;CE InstanceRef&lt;/b&gt; refers to either the VI static instance context, if &lt;b&gt;create instance is FALSE&lt;/b&gt;, or dynamically created instance context, if &lt;b&gt;create instance&lt;/b&gt; is TRUE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">loaded functions</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns function names whose FuncVIs have been loaded at the current call of the VI. Note that VI only loads FuncVIs that are not loaded yet (more precise, FuncVIs to which CalcExpress doesn't have opened VI Reference).</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">new instance</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if the VI creates dynamic CalcExpress instance context; otherwise it returns FALSE.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Eval Script.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI evaluates previously parsed CalcExpress scripts. The VI takes a reference to CalcExpress instance context that is returned by &lt;a href="hprj:[ce] CalcExpress - Parse Script.vi"&gt;[ce] CalcExpress - Parse Script.vi&lt;/a&gt;. The VI uses this reference to both access parsed script and keep intermediate data. Due to the VI is reentrant, several instances of it can simultaneously evaluate scripts. Note that several evaluators can't use the same instance context at a time.\n</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI evaluates &lt;a href="hprj:ce_syntax.html"&gt;CalcExpress&lt;/a&gt; expressions and sequential scripts. To process non-sequential scripts involving loops and branches, use &lt;a href="hprj:cse.mnu"&gt;CSE VIs&lt;/a&gt;.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is reentrant. For each its instance, the VI stores an expression parsed last along with a result of parsing. When the VI is called, it compares an input expression with an expression stored within the same instance. If they differ, the VI parses the input expression; otherwise it skips the parsing phase and uses a stored parsed expression to perform an evaluation.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">string value</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns value of an expression if it has other than &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;DBL Number&lt;/a&gt; data type. A value is represented in LabVIEW Flattened-To-String format unless expression datatype is &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;String&lt;/a&gt;.\nNOTICE: the VI returns value of an expression but not an &lt;a href="hprj:ce_syntax_op_punctuator.html#ce_op_semicolon"&gt;expression-statement&lt;/a&gt;, which does not have a value. Don't put a semicolon after the last expression in a script if you need to obtain its value through this indicator.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress Light.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI evaluates &lt;a href="hprj:ce_syntax.html"&gt;CalcExpress&lt;/a&gt; expressions and sequential scripts. To process non-sequential scripts involving loops and branches, use &lt;a href="hprj:cse.mnu"&gt;CSE VIs&lt;/a&gt;.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is reentrant. For each its instance, the VI stores an expression parsed last along with a result of parsing. When the VI is called, it compares an input expression with an expression stored within the same instance. If they differ, the VI parses the input expression; otherwise it skips the parsing phase and uses a stored parsed expression to perform an evaluation.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Diagnose Script.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns names of variables and functions referenced in a CalcExpress expression or sequential script. To analyze a parsed script, pass reference to its instance context to &lt;b&gt;CE InstanceRef&lt;/b&gt; control; otherwise, pass a script source to &lt;b&gt;expression&lt;/b&gt; control.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">Items</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies what names the VI is to return:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="Variables">The VI returns variable names. It's default value.</EnumValue>
            <EnumValue ID="1" STR="Functions">The VI returns function names (both FuncVI and FastFunc functions).</EnumValue>
            <EnumValue ID="2" STR="FuncVI functions">The VI returns names of FuncVI functions only.</EnumValue>
            <EnumValue ID="3" STR="FastFunc functions">The VI returns names of FastFunc functions only.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">sort (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies whether an output array of names need be sorted. If it is TRUE, elements in Array of Items are sorted in alphabetical case-insensitive order. Default value is FALSE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Array of Items</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns names of requested items found in the script. The array doesn't contain duplicate elements.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Original List of Items</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a spread-sheet string with item names in order they are met in the script. For function, a function name is folowed by number of arguments in the function call.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - FuncVI search paths.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI can be used to extend a set of paths used by CalcExpress to search for FuncVIs.\nCalcExpress dynamically calls FuncVI functions. To call a FuncVI, CalcExpress needs to know a location of the FuncVI to open a VI reference to it. To find out a FuncVI CalcExpress uses a set of search paths. The set includes predefined paths that refer to FuncVI libraries supplied with CalcExpress. Furthermore, this VI lets you define additional paths to search for FuncVIs (user-defined paths).\n</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">cmd</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a required action:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="get">the VI returns search paths.</EnumValue>
            <EnumValue ID="1" STR="set">the VI stores paths specified in &lt;b&gt;user paths&lt;/b&gt; as user-defined paths.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">user paths</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies user-defined search paths if &lt;b&gt;cmd&lt;/b&gt; is &lt;i&gt;set&lt;/i&gt;.  Relative paths have to be specified relatively of this VI location (including a VI library).</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">base path</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns an absolute path of this VI with VI name rejected.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">search paths</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a full set of search paths that includes both user-defined and predefined paths. Herewith, user-defined paths are more preferable; i.e. they are located in the beginning of the search paths array.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">user paths out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns user-defined search paths only. </Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Load Functions.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI can be used to explicitly load FuncVIs to memory.\nIf CalcExpress needs to call a FuncVI function, it looks for an opened VI reference that refers to the FuncVI. If there is no an opened reference, CalcExpress implicitly opens it; i.e. it makes LabVIEW load the FuncVI. You can reduce time required to perform the first call of a FuncVI if you preliminary load it.\nThe VI only recognizes function names. It looks for the corresponding FuncVI in search paths defined in &lt;a href="hprj:Func - FuncVI search paths.vi"&gt;Func - FuncVI search paths.vi&lt;/a&gt;.\n</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">test arg num (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is an optional parameter. If it is TRUE, the VI verifies a number that follows a function name for valid number of parameters on which the function can operate. If a function name is not followed by a number, the VI does not perform the verification. By default, &lt;b&gt;test arg num&lt;/b&gt; is FALSE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error message</Property>
          <Property Name="CustomRule">TRUE</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Unload Functions.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI can be used to explicitly unload FuncVIs from memory.\nIf CalcExpress opens a VI reference to a FuncVI (thereby it loads the FuncVI to memory), the reference is opened until the top level VI in its callers hierarchy stops. You can use this VI to close VI references to FuncVIs used by CalcExpress. This causes FuncVIs to be unloaded if there are no other opened references to them. Note that CalcExpress implicitly load a FuncVI if a call of corresponding function is performed.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">unload all (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If it is TRUE, the VI closes references to all FuncVIs that are opened by CalcExpess and CSE. Otherwise, the VI only closes references to the specified FuncVIs.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\ceBase.llb\Exp - Get VC Handle.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns a handle of the variable context associated with CalcExpress instance to which &lt;B&gt;InstanceRef&lt;/B&gt; control refers.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs.\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#cevi_exmpl_aargs"&gt;Example of use&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the handle of the Variable Context used by the CalcExpress instance to which &lt;b&gt;InstanceRef&lt;/b&gt; refers.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">writer ID</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the actual &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; value of the CalcExpress instance to which &lt;b&gt;InstanceRef&lt;/b&gt; refers.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\ceBase.llb\Exp - Error handler.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Use this VI to declare custom CalcExpress errors in FuncVIs. </Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The main objective of this VI is declaring errors in FuncVIs. The VI gives you direct access to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt; associated with the CalcExpress instance to which &lt;b&gt;InstanceRef&lt;/b&gt; refers. In general, there is no need to immediately use this VI because CalcExpress VIs handle typical errors. However, you can use the VI to handle errors that are specific for your FuncVIs. With the help of this VI, you can specify an error description and an error code that are returned by CalcExpress and CSE VIs.\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#ce_funcvi_example_args"&gt;Example of use&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">add FuncName (T)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If TRUE (by default), the VI appends a name of function associated with the calling FuncVI to the end of &lt;b&gt;error message in&lt;/b&gt; when it puts the message to the Error Protocol.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">cmd (1:set)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an operation to perform:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="init">The VI resets the error in CalcExpress instance context referred by &lt;b&gt;InstanceRef&lt;/b&gt; and clears the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;. This operation executes if only &lt;b&gt;error in&lt;/b&gt; is FALSE.</EnumValue>
            <EnumValue ID="1" STR="set">The VI saves both an error status and error code specified by &lt;b&gt;error code in&lt;/b&gt; to the CalcExpress instance context referred by &lt;b&gt;InstanceRef&lt;/b&gt;, and appends &lt;b&gt;error message in&lt;/b&gt; to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;. This operation executes only if &lt;b&gt;error in&lt;/b&gt; is TRUE, it has no effects if &lt;b&gt;error in&lt;/b&gt; is FALSE. This is default value.</EnumValue>
            <EnumValue ID="2" STR="get">The VI returns the error information stored in CalcExpress instance context referred by &lt;b&gt;InstanceRef&lt;/b&gt;. It returns an error status in &lt;b&gt;error out&lt;/b&gt; indicator, an error code in &lt;b&gt;error code out&lt;/b&gt; indicator and contents of the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt; in &lt;b&gt;error message out&lt;/b&gt; indicator. This operation executes independently of &lt;b&gt;error in&lt;/b&gt; state.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an error condition occurred. The behavior of the VI depends on both &lt;b&gt;error in&lt;/b&gt; and &lt;b&gt;cmd&lt;/b&gt; values.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error code in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a custom error code that CalcExpress and CSE VIs will return if an error occurs. If it is equal to zero (by default), the default &lt;a href="hprj:errors.html#err_ce_vi"&gt;CalcExpress error code&lt;/a&gt; is stored; typically, it is Runtime Error code equal to 7103. The VI uses this control only if &lt;b&gt;cmd&lt;/b&gt; is &lt;i&gt;set&lt;/i&gt; and &lt;b&gt;error in&lt;/b&gt; is TRUE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error message in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">defines an error message if &lt;b&gt;cmd&lt;/b&gt; equals &lt;i&gt;set&lt;/i&gt;. The VI appends the message to the end of the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt; if &lt;b&gt;cmd&lt;/b&gt; equals &lt;i&gt;set&lt;/i&gt; and &lt;b&gt;error in&lt;/b&gt; is TRUE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If &lt;b&gt;cmd&lt;/b&gt; is equal to &lt;i&gt;get&lt;/i&gt;, it contains an error status stored in the CalcExpress instance context referred by &lt;b&gt;InstanceRef&lt;/b&gt;. It is TRUE if an error occurred; otherwise, it is FALSE. If &lt;b&gt;cmd&lt;/b&gt; is other than &lt;i&gt;get&lt;/i&gt;, &lt;b&gt;error out&lt;/b&gt; contains the same value as &lt;b&gt;error in&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error code out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If &lt;b&gt;cmd&lt;/b&gt; is equal to &lt;i&gt;get&lt;/i&gt;, it contains an error code stored in CalcExpress instance context referred by &lt;b&gt;InstanceRef&lt;/b&gt;. If an error occurred, it can contain CalcExpress error code. LabVIEW error code, or a user-defined error code, if you specified any. If no error occurred, it contains zero. If &lt;b&gt;cmd&lt;/b&gt; is other than &lt;i&gt;get&lt;/i&gt;, &lt;b&gt;error code out&lt;/b&gt; flows through and contains the exact same value passed to &lt;b&gt;error code in&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error message out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If &lt;b&gt;cmd&lt;/b&gt; is equal to &lt;i&gt;get&lt;/i&gt;, it contains a values of the Error Protocol. Otherwise, it contains the same value as &lt;b&gt;error message in&lt;/b&gt;.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\ceBase.llb\Exp - Get CalcExpress Error as Error Cluster.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Use this VI to retrieve CalcExpress error as the standard LabVIEW error cluster. If it is allowed, the VI returns error information stored in the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt; associated with the CalcExpress instance to which &lt;b&gt;InstanceRef&lt;/b&gt; refers.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">Get CE Error (T)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If it is TRUE (by default), the VI calls CalcExpress Engine to retrieve error information. If there is an error occured prior this VI executes, information on the error is returned in &lt;b&gt;error out&lt;/b&gt;. Most FuncVI support VIs use boolean &lt;error in&gt; and &lt;error out&gt;. You might connect &lt;b&gt;Get CE Error&lt;/b&gt; to a boolean &lt;error out&gt; indicator of these VIs for data flow.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is the standard LabVIEW error cluster. The VI executes normally only if &lt;b&gt;error in&lt;/b&gt; does not indicate any error, otherwise the VI merely passes the &lt;b&gt;error in&lt;/b&gt; value to &lt;b&gt;error out&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dup Get CE Error</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the same value as &lt;b&gt;Get CE Error&lt;/b&gt; control.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is the standard LabVIEW error cluster. If &lt;b&gt;error in&lt;/b&gt; indicated an error, the &lt;b&gt;error out&lt;/b&gt; contains the same information. Otherwise, the VI returns information on CalcExpress error if any occurred prior this VI executes.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - VarMan Error handler.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Use this VI in FuncVIs to handle errors produced by &lt;a href="hprj:vm-top.mnu"&gt;VarMan VIs&lt;/a&gt;.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs.\nIf a VarMan VI indicates that an error occurred while executing, this VI posts the error description to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;. The VI performs nothing if both &lt;b&gt;error in&lt;/b&gt; and &lt;b&gt;VM error code&lt;/b&gt; controls specify the absence of an error.\n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#cevi_exmpl_aargs"&gt;Example of use&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">var name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the variable name on which a VarMan VI operated. The VI uses this variable name to format an error message if an error occurred during the operation.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dup var name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;var name&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VM error code</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a &lt;a href="hprj:errors.html#err_vm_engine"&gt;VarMan Engine error code&lt;/a&gt;. Wire this terminal to an &lt;b&gt;err code&lt;/b&gt; output of a VarMan VI. If &lt;b&gt;VM error code&lt;/b&gt; indicates an error, the VI forms a relevant error message and puts the message to &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;the Error Protocol&lt;/a&gt;.</Property>
          <Property Name="EnumValues">Disable</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="No error"/>
            <EnumValue ID="1" STR="Invalid variable type"/>
            <EnumValue ID="2" STR="Variable not found"/>
            <EnumValue ID="3" STR="Variable already exists"/>
            <EnumValue ID="4" STR="Invalid context handle"/>
            <EnumValue ID="5" STR="Input error"/>
            <EnumValue ID="6" STR="Invalid data format"/>
            <EnumValue ID="7" STR="No history attached"/>
            <EnumValue ID="8" STR="History already attached"/>
            <EnumValue ID="9" STR="Invalid history parameters"/>
            <EnumValue ID="10" STR="Wrong variable name"/>
            <EnumValue ID="11" STR="Wrong alias name"/>
            <EnumValue ID="12" STR="Non-unique alias"/>
            <EnumValue ID="13" STR="Alias not found"/>
            <EnumValue ID="14" STR="No alias associated"/>
            <EnumValue ID="15" STR="Alias already associated"/>
            <EnumValue ID="16" STR="Wrong context name"/>
            <EnumValue ID="17" STR="Non-unique context name"/>
            <EnumValue ID="18" STR="Context name not found"/>
            <EnumValue ID="19" STR="Invalid parameter"/>
            <EnumValue ID="20" STR="Generic error"/>
            <EnumValue ID="21" STR="Memory Full"/>
            <EnumValue ID="22" STR="Unrecognized LV error"/>
            <EnumValue ID="23" STR="Unknown error code"/>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dup VM error code</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;VM error code&lt;/b&gt;.</Property>
          <Property Name="EnumValues">Disable</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="No error"/>
            <EnumValue ID="1" STR="Invalid variable type"/>
            <EnumValue ID="2" STR="Variable not found"/>
            <EnumValue ID="3" STR="Variable already exists"/>
            <EnumValue ID="4" STR="Invalid context handle"/>
            <EnumValue ID="5" STR="Input error"/>
            <EnumValue ID="6" STR="Invalid data format"/>
            <EnumValue ID="7" STR="No history attached"/>
            <EnumValue ID="8" STR="History already attached"/>
            <EnumValue ID="9" STR="Invalid history parameters"/>
            <EnumValue ID="10" STR="Wrong variable name"/>
            <EnumValue ID="11" STR="Wrong alias name"/>
            <EnumValue ID="12" STR="Non-unique alias"/>
            <EnumValue ID="13" STR="Alias not found"/>
            <EnumValue ID="14" STR="No alias associated"/>
            <EnumValue ID="15" STR="Alias already associated"/>
            <EnumValue ID="16" STR="Wrong context name"/>
            <EnumValue ID="17" STR="Non-unique context name"/>
            <EnumValue ID="18" STR="Context name not found"/>
            <EnumValue ID="19" STR="Invalid parameter"/>
            <EnumValue ID="20" STR="Generic error"/>
            <EnumValue ID="21" STR="Memory Full"/>
            <EnumValue ID="22" STR="Unrecognized LV error"/>
            <EnumValue ID="23" STR="Unknown error code"/>
          </Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Unflatten-From-String Error handler.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Use this VI in FuncVIs to handle errors produced by the &lt;b&gt;Unflatten From String&lt;/b&gt; function.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs. \nA FuncVI obtains an argument value in the Flattened-To-String format if the argument type is either one of Complex types or a user-defined &lt;a href="hprj:dtypes.html"&gt;data type&lt;/a&gt;. The VI tests an error condition returned by the &lt;u&gt;Unflatten From String&lt;/u&gt; LabVIEW function, which is used to convert an argument value from the Flattened-To-String format to its native format. If a conversion error status is passed to the VI, it posts the error description to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;.\n\nThis type of error is atypical. It cannot occur unless a specified argument type mismatches its flattened data. Care must be taken wherever a user-defined data type is bound with flattened data; for example, when returning a FuncVI result.\n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#cevi_exmpl_aargs"&gt;Example of use&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">Unflatten Error status</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies if an error occurred during conversion of data from Flattened-To-String format to native LabVIEW data format. If TRUE, the VI puts relevant error message to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">argument number</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is used to specify an argument number on which the error occurred. If it is greater than or equal to 1, the VI puts the argument number to an error description to simplify debugging; otherwise, the VI omits argument number information. Keep it unwired if a FuncVI operates on single argument. By default, &lt;b&gt;argument number&lt;/b&gt; is equal to -1.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - get function name_.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">This VI returns a name of function and a name of FuncVI if it's called from a FuncVI hierarchy.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - LV runtime error handler_.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Use this VI in FuncVIs to handle errors produced by LabVIEW VIs and functions.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs. \nThe VI stores an error code, which LabVIEW VIs return, within a variable context associated with the CalcExpress instance to which &lt;b&gt;InstanceRef&lt;/b&gt; control refers. This error code can be further evaluated in a script with the help of &lt;a href="hprj:cefunc_error.html#cef_errno"&gt;errno&lt;/a&gt; function. Review &lt;a href="hprj:ce_rt_error.html"&gt;Non-Fatal runtime errors&lt;/a&gt; topic for details.\n\nTypically, the VI does not produce a CalcExpress error if it obtains LabVIEW VIs error conditions. However, you can make the VI to do this if you pass TRUE to &lt;b&gt;Gen CE Error&lt;/b&gt; control. In this case, the VI posts a description of LabVIEW error to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt; if an error occurred.\n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#cevi_exmpl_nargs"&gt;Example of use&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">LabVIEW error code</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specidies an error code returned by LabVIEW functions and VIs. The VI assigns this value to &lt;a href="hprj:ce_rt_error.html"&gt;rtErrorCode&lt;/a&gt; variable within a variable context used by the calling CalcExpress instance.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicator contains TRUE if the VI puts an error description to &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;the Error Protocol&lt;/a&gt;; i.e. if &lt;b&gt;Gen CE error&lt;/b&gt; is TRUE and &lt;b&gt;LabVIEW error code&lt;/b&gt; is not zero.  Otherwise it contains the same value as error in.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - LV runtime error handler (Error Cluster).vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Use this VI in FuncVIs to handle errors produced by LabVIEW VIs and functions.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs. \nThe VI stores an error code, which LabVIEW VIs return, within a variable context associated with the CalcExpress instance to which &lt;b&gt;InstanceRef&lt;/b&gt; control refers. This error code can be further evaluated in a script with the help of &lt;a href="hprj:cefunc_error.html#cef_errno"&gt;errno&lt;/a&gt; function. Review &lt;a href="hprj:ce_rt_error.html"&gt;Non-Fatal runtime errors&lt;/a&gt; topic for details.\n\nTypically, the VI does not produce a CalcExpress error if it obtains LabVIEW VIs error conditions. However, you can make the VI to do this if you pass TRUE to &lt;b&gt;Gen CE Error&lt;/b&gt; control. In this case, the VI posts a description of LabVIEW error to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt; if an error occurred.\n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#cevi_exmpl_nargs"&gt;Example of use&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">LabVIEW error</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is the typical LabVIEW error cluster that should contain an error conditions returned by LabVIEW functions or VIs. If it signals an error, the VI assigns the specified error code to &lt;a href="hprj:ce_rt_error.html"&gt;rtErrorCode&lt;/a&gt; variable within a variable context used by the calling CalcExpress instance.</Property>
          <Property Name="ClusterMembers">Enable</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">LabVIEW error.status</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates error status.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">LabVIEW error.code</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates error code.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">LabVIEW error.source</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains additional error information.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dup LabVIEW error</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;LabVIEW error&lt;/b&gt;.</Property>
          <Property Name="ClusterMembers">Disable</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicator contains TRUE if the VI puts an error description to &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;the Error Protocol&lt;/a&gt;; i.e. if &lt;b&gt;Gen CE error&lt;/b&gt; is TRUE and &lt;b&gt;LabVIEW error&lt;/b&gt; indicates an error.  Otherwise it contains the same value as error in.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">LV error code</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a value as the &lt;b&gt;code&lt;/b&gt; member of &lt;b&gt;LabVIEW error&lt;/b&gt; cluster.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">LV error status</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a value as the &lt;b&gt;status&lt;/b&gt; member of &lt;b&gt;LabVIEW error&lt;/b&gt; cluster.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get list of string arguments.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns values of function arguments that all must have &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;String&lt;/a&gt; data type. If any argument is a name of varible, the VI returns a value of the variable.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs.\nThe VI verifies both number of arguments and argument data types. If the VI detects any error, it returns an error status and posts the error description to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;. A CalcExpress VI returns the error description when it completes evaluating the expression.\n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#cevi_exmpl_sargs"&gt;Example of use&lt;/a&gt;.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get list of numeric arguments.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns values of function arguments that all must have &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;DBL Number&lt;/a&gt; data type. If any argument is a name of varible, the VI returns a value of the variable.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs.\nThe VI verifies both number of arguments and argument data types. If the VI detects any error, it returns an error status and posts the error description to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;. A CalcExpress VI returns the error description when it completes evaluating the expression.\n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#cevi_exmpl_nargs"&gt;Example of use&lt;/a&gt;.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get list of arguments.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns values and &lt;a href="hprj:dtypes.html"&gt;data types&lt;/a&gt; of function arguments. If any argument is a name of varible, the VI returns a value and data type of the variable.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs.\nThe VI verifies number of arguments. If the VI detects any error, it returns an error status and posts the error description to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;. A CalcExpress VI returns the error description when it completes evaluating the expression.\n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#ce_funcvi_example_args"&gt;Example of use&lt;/a&gt;.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get argument.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns value and &lt;a href="hprj:dtypes.html"&gt;data type&lt;/a&gt; of a function argument. If the argument is a name of varible, the VI returns a value and data type of the variable.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs.\nThe VI verifies number of arguments, which must be in the specified range. If the VI detects any error, it returns an error status and posts the error description to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;. A CalcExpress VI returns the error description when it completes evaluating the expression.\n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#ce_funcvi_example_args"&gt;Example of use&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">ena NonNum? (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If TRUE, an argument is allowed to be of any data type. If FALSE (by default), only DBL Number data type is allowed.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">num</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns numeric value of the argument if &lt;b&gt;type&lt;/b&gt; indicates the argument has DBL Number data type.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">str</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns string value of the argument if &lt;b&gt;type&lt;/b&gt; indicates the argument has data type other than DBL Number. If an argument has either one of Complex data types or a user-defined data type, its value is present in the Flattened-To-String format.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">type</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns actual data type code of the argument. If the argument is a variable name, &lt;b&gt;type&lt;/b&gt; contains a data type of the variable.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get declared arguments.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns values and &lt;a href="hprj:dtypes.html"&gt;data types&lt;/a&gt; of arbitrary function arguments according to the given specification. The VI makes it possible to define default values for optional function arguments if they are omitted in a function call. The VI allows obtaining a variable name as an argument value.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs.\nThe VI verifies both number of arguments and argument data types according to the specifications. If the VI detects any error, it returns an error status and posts the error description to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;. A CalcExpress VI returns the error description when it completes evaluating the expression.\n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#cevi_exmpl_aargs"&gt;Example of use&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">arg descriptors</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies attributes of expected arguments. The VI verifies data types and returns values of the arguments declared in this control, it ignores arguments not declared here.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">arg descriptors..index</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">of the argument in &lt;b&gt;arg list&lt;/b&gt;. It is the same as an argument index in a function call if &lt;b&gt;arg list&lt;/b&gt; contains all function arguments.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">arg descriptors..type</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an expected data type code of the argument. Any argument data type is allowed if &lt;b&gt;type&lt;/b&gt; is equal to -1. The VI produces an error if data type of an actual argument doesn't match the expected data type and &lt;b&gt;type&lt;/b&gt; is not -1.\nThe VI returns variable values unless &lt;b&gt;type&lt;/b&gt; is set to &lt;a href="hprj:dtypes.html"&gt;Identifier&lt;/a&gt;. If &lt;b&gt;type&lt;/b&gt; is Identifier, the VI does not attempt to get a variable value and returns the identifier (a variable name).</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">arg descriptors..default num</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a default value for arguments of DBL Number data type. It is returned as a value of the respective argument if &lt;b&gt;index&lt;/b&gt; is beyond of &lt;b&gt;arg list&lt;/b&gt; boundaries.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">arg descriptors..default str</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a default value for arguments of data types other than DBL Number. It is returned as a value of the respective argument if &lt;b&gt;index&lt;/b&gt; is beyond of &lt;b&gt;arg list&lt;/b&gt; boundaries.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">num list</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">The VI returns numeric values through this indicator. The size of &lt;b&gt;num list&lt;/b&gt; is the same as the size of &lt;b&gt;arg descriptors&lt;/b&gt;. Order of elements corresponds to the order of descriptors in &lt;b&gt;arg descriptors&lt;/b&gt;. An element value is valid if the respective element of &lt;b&gt;type list&lt;/b&gt; indicates the value has DBL Number data type.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">str list</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">The VI returns string values through this indicator. The size of &lt;b&gt;str list&lt;/b&gt; is the same as the size of &lt;b&gt;arg descriptors&lt;/b&gt;. Order of elements corresponds to the order of descriptors in &lt;b&gt;arg descriptors&lt;/b&gt;. An element value is valid if the respective element of &lt;b&gt;type list&lt;/b&gt; indicates the value has data type other than DBL Number.  If an argument has either one of Complex data types or a user-defined data type, its value is present in the Flattened-To-String format.\n</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">type list</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">The VI returns value data types through this indicator. Elements of &lt;b&gt;type list&lt;/b&gt; contain actual data types of the respective elements in &lt;b&gt;num list&lt;/b&gt; and &lt;b&gt;str list&lt;/b&gt;. Note that a value data type is the same as &lt;b&gt;type&lt;/b&gt; specified in the respective element of &lt;b&gt;arg descriptors&lt;/b&gt; unless the descriptor contains -1 in its &lt;b&gt;type&lt;/b&gt; member. The size of &lt;b&gt;type list&lt;/b&gt; is the same as the size of &lt;b&gt;arg descriptors&lt;/b&gt;. Order of elements corresponds to the order of descriptors in &lt;b&gt;arg descriptors&lt;/b&gt;.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Menus\ce-top.mnu">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">This palette contains CalcExpress VIs.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Menus\ce-fvi.mnu">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">This palette contains VIs to be used for developing FuncVIs (CalcExpress functions implemented as VIs).</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Menus\ce-func.mnu">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">This palette contains VIs to support using FuncVIs in applications.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Execute Parsed Script.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI executes a parsed &lt;a href="hprj:cse_syntax.html"&gt;CSE Script&lt;/a&gt;. The VI takes a reference to CSE instance context returned by &lt;a href="hprj:CSE - Parse Script.vi"&gt;CSE - Parse Script.vi&lt;/a&gt; and uses this reference to access a parsed script and keep intermediate data. The VI is reentrant, instances of the VI can simultaneously execute parsed scripts.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">can be used to arrange cooperative access to variables. If you pass a valid handle of variable context to this control, you can manipulate variables of the given context in a script. To open variable context use &lt;a href="hprj:VM - Open Context.vi"&gt;VM - Open Context.vi&lt;/a&gt;. If you keep this connector unwired or pass an invalid handle, the VI implicitly opens a temporary variable context to be able to operate on variables. The VI closes the temporary context after it finishes executing a script.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Callback VI RefNum</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">Optional control accepts a strictly typed VI refnum. You can pass a VI refnum of a CSE Callback VI to it in order to get control over script execution. A Callback VI will be called before script execution starts and then it can control conditions to be called next time. Finally, it will be called after a script completed. A Callback VI has access to all required parameters to observe and/or control script execution. It is recommended to open a Callback VI reference with the use of &lt;a href="hprj:CSE - Open Callback VI Reference.vi"&gt;CSE - Open Callback VI Reference.v&lt;/a&gt;i.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Close FuncVI Refs (T)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If TRUE (by default), the VI closes VI references to used FuncVIs when it finishes.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dup Callback VI RefNum</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;Callback VI RefNum&lt;/b&gt;.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Execute Script (Basic).vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI executes a parsed &lt;a href="hprj:cse_syntax.html"&gt;CSE Script&lt;/a&gt; with additional functionality. The VI takes a reference to CSE instance context returned by &lt;a href="hprj:CSE - Parse Script.vi"&gt;CSE - Parse Script.vi&lt;/a&gt; and uses this reference to access a parsed script and keep intermediate data. The VI is reentrant, instances of the VI can simultaneously execute parsed scripts.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is the basic CSE script executor. It can be used as is to execute scripts. As well, you can use it to create a custom script engine.\n\nIf &lt;B&gt;Run mode&lt;/B&gt; is equal to zero (&lt;i&gt;Execute&lt;/i&gt;), the VI completely executes a script starting from &lt;B&gt;Stm Index&lt;/B&gt; position (statement) in a regular mode (debugging feature is off). Otherwise, the VI stops if either specified action is completed or a breakpoint is achieved.\n</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VC Handle</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">has to contain a handle of variable context in order to make it possible to operate on variables in a script. Use &lt;a href="hprj:VM - Open Context.vi"&gt;VM - Open Context.vi &lt;/a&gt;to open a variable context</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Stm Index</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an index of the statement in the parsed script that should be executed, or from which execution should either start or continue. It has to be zero when you start script execution. Then, if you run the VI in a debugging mode, pass value of &lt;b&gt;Stm Index out&lt;/b&gt; to &lt;b&gt;Stm Index&lt;/b&gt; to continue executing the script from the position it was suspended unless you intend to change script flow. By default, &lt;b&gt;Stm Index&lt;/b&gt; is equal to zero.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Run mode</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a mode to execute a script. The VI provides modes described below. In &lt;i&gt;Execute&lt;/i&gt; mode, the VI executes a script completely with no debugging features provided. Debugging modes specify conditions to suspend script execution and return. Debugging modes have &lt;u&gt;line mode&lt;/u&gt; modification marked (&lt;b&gt;LM&lt;/b&gt;). When &lt;u&gt;line mode&lt;/u&gt;, the VI considers a set of statements starting in the same line as a single statement.</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="Execute">It is a regular mode to execute a script. The VI starts executing a script from the position specified by &lt;b&gt;Stm Index&lt;/b&gt; and runs until either the script is completed or an error occurs. It's default valiue.</EnumValue>
            <EnumValue ID="1" STR="Abort">terminates script execution and produces an error.</EnumValue>
            <EnumValue ID="2" STR="Run">The VI starts executing a script from the position specified by &lt;b&gt;Stm Index&lt;/b&gt; and runs until one of the conditions is met: a breakpoint is achieved, the script is completed, or an error occurs.</EnumValue>
            <EnumValue ID="3" STR="Step">The VI executes a single statement.</EnumValue>
            <EnumValue ID="4" STR="Step Over">If the current statement begins a syntax node (e.g. &lt;b&gt;if&lt;/b&gt;, &lt;b&gt;for&lt;/b&gt;, &lt;b&gt;while&lt;/b&gt;), the VI executes all the statements of the node (and nested nodes, if any), and stops on the statement immediately following it. The VI stops within the node if a breakpoint is achieved.</EnumValue>
            <EnumValue ID="5" STR="Step Out">The VI runs until it leaves a current syntax node (e.g. body of &lt;b&gt;if&lt;/b&gt;, &lt;b&gt;for&lt;/b&gt;, &lt;b&gt;while&lt;/b&gt;), and stops on the statement immediately following it. The VI stops within the node if a breakpoint is achieved.</EnumValue>
            <EnumValue ID="6" STR="Run (LM)">It's &lt;u&gt;line mode&lt;/u&gt; modification of &lt;i&gt;Run&lt;/i&gt;.</EnumValue>
            <EnumValue ID="7" STR="Step (LM)">It's &lt;u&gt;line mode&lt;/u&gt; modification of &lt;i&gt;Step&lt;/i&gt;.</EnumValue>
            <EnumValue ID="8" STR="Step Over (LM)">It's &lt;u&gt;line mode&lt;/u&gt; modification of &lt;i&gt;Step Over&lt;/i&gt;.</EnumValue>
            <EnumValue ID="9" STR="Step Out (LM)">It's &lt;u&gt;line mode&lt;/u&gt; modification of &lt;i&gt;Step Out&lt;/i&gt;.</EnumValue>
            <EnumValue ID="10" STR="unsupported">Just a stub value.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Breakpoints</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an array of statement indexes considered as breakpoints. The VI stops if any of the specified breakpoints is achieved while the VI is executing the script in a debugging mode.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Stm Index out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns an index of the statement to be executed next. If either the script is completed or an error occurred, &lt;b&gt;Stm Index out&lt;/b&gt; returns -1.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Stop Reason</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a reason of the VI stop. The VI can only return &lt;i&gt;Action completed&lt;/i&gt; and &lt;i&gt;Pause to breath&lt;/i&gt; values, all the other values are reserved for compatibility with CSE Callback VIs.</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="Exec Start">It's reserved for CSE Callback VI.</EnumValue>
            <EnumValue ID="1" STR="Action completed">It's a typical termination status. If &lt;b&gt;Stm Index out&lt;/b&gt; is less than zero, the VI finished script execution; herewith, a completion status is indicated in &lt;b&gt;error out&lt;/b&gt;. If &lt;b&gt;Stm Index out&lt;/b&gt; is equal to or greater than zero, the VI either performed the operation specified in &lt;i&gt;Run&lt;/i&gt; mode, or achieved a specified breakpoint.</EnumValue>
            <EnumValue ID="2" STR="pause to breath">The VI has not completed the required operation but suspended script execution because it completed number of statements specified in &lt;b&gt;pause counter&lt;/b&gt; parameter of &lt;b&gt;exec parameters&lt;/b&gt; cluster.</EnumValue>
            <EnumValue ID="3" STR="reserved 1">Reserved.</EnumValue>
            <EnumValue ID="4" STR="reserved 2">Reserved.</EnumValue>
            <EnumValue ID="5" STR="custom">Not used.</EnumValue>
          </Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Parse Script.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI parses a &lt;a href="hprj:cse_syntax.html"&gt;CSE script&lt;/a&gt; and returns a reference to a CSE instance context containing the parsed script. This reference is to be used to execute a script with &lt;a href="hprj:CSE - Execute Parsed Script.vi"&gt;CSE - Execute Parsed Script.vi&lt;/a&gt;. In addition, the VI loads FuncVIs required to execute a script.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is reentrant, each instance of it has its own context to store a script parsed last (called a static context). In addition, you can make the VI create a dynamic instance context if a single VI instance should produce a few parsed scripts; e.g. within a loop. Note that each dynamic context is unique in difference from the static context. A dynamic context should be explicitly closed with the help of &lt;a href="hprj:CSE - Close Instance.vi"&gt;CSE - Close Instance.vi&lt;/a&gt;. Furthermore, all opened dynamic contexts will be implicitly closed when this VI is unloaded; i.e. no its instances stay in memory.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">CSE RefNum</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a reference number of CSE instance context containing the parsed script. If you specify &lt;b&gt;action&lt;/b&gt; control equal to 1 (&lt;i&gt;parse (dyn instance)&lt;/i&gt;), &lt;b&gt;CSE RefNum&lt;/b&gt; returns a reference to a new-created dynamic instance context. Otherwise, it contains a reference to the static context of the called VI instance. Note that a dynamic context should be explicitly closed even if the VI returns an error.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Script name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is an optional parameter. If you specify a script name, it will appear in an error message along with a line number in order to indicate location of both parsing and runtime errors.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Script</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is to be parsed. See &lt;a href="hprj:cse_syntax.html"&gt;CSE Script Syntax&lt;/a&gt; for details.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">load FuncVIs</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a method to load &lt;a href="hprj:ce_functions.html#ce_func_implementation_funcvi"&gt;FuncVIs&lt;/a&gt;. Make the VI to load FuncVIs if a script can contain calls of FuncVI functions; it has two advantages. First, CSE can detect an invalid function call while parsing but not evaluating. Second, CSE will be able to evaluate a script much faster if all required FuncVIs are preliminary loaded.</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="don't load">The VI doesn't load FuncVIs.</EnumValue>
            <EnumValue ID="1" STR="load">The VI loads FuncVIs of the functions that are not recognized as embedded (FastFunc) functions.</EnumValue>
            <EnumValue ID="2" STR="load &amp; test">The VI loads FuncVIs as described above. In addition, the VI verifies calls of FuncVI functions for correct number of parameters. The VI returns an error if any mismatch found. This is default value.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">action</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an operation to perform:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="parse">The VI parses &lt;b&gt;Script&lt;/b&gt; and stores its parsed version (the parsed script) in a static context of the current VI instance. This is default value.</EnumValue>
            <EnumValue ID="1" STR="parse (dyn instance)">The VI creates a dynamic instance context and stores the parsed script in it; the static context stays unchanged. This way, a single instance of the VI can produce more than one parsed script.</EnumValue>
            <EnumValue ID="2" STR="test syntax">The VI parses &lt;b&gt;Script&lt;/b&gt; and stores the parsed script in the static context. The VI unloads FuncVIs after completion if it has loaded any according to&lt;b&gt; load FuncVI&lt;/b&gt; specifier.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">parameters</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies optional parameters:</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">parameters.AutoParse</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If FALSE, the VI parses the script every time it is called. If TRUE (default), the VI bypasses the parsing phase if the static context of the called VI instance already contains a compiled version of the input script. This optimization significantly decreases the aggregate time required to parse and execute a script when called inside a loop. Note that the VI always parses the script when creating a dynamic instance context.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">parameters.GroupStm</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If TRUE, the VI groups sequential expression statements into a single statement. This optimization can increase script execution speed. The default value is FALSE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">parameters.ErrSrcMaxLen</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">defines the maximum length of a quotation from a source script in error messages. The default value is 180.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">directives</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">defines parsing directives:</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">directives.enaNamedConst</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">enables (TRUE) or disables (FALSE) treating &lt;a href="hprj:ce_syntax_misc.html#ce_syntax_namedconst"&gt;Named Constants&lt;/a&gt; during script parsing. This behavior can be altered during the parsing phase by using the &lt;b&gt;$NCON&lt;/b&gt; (enable) and &lt;b&gt;$NCOFF&lt;/b&gt; (disable) &lt;a href="hprj:directives.html"&gt;Parsing Directives&lt;/a&gt; directly within the script.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">loaded functions</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns function names whose FuncVIs have been loaded at the current call of the VI. Note that VI only loads FuncVIs that are not loaded yet (more precise, FuncVIs to which CalcExpress doesn't have opened VI Reference).</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dynamic instance</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if a dynamic CSE instance context has been created to store the parsed script. The VI creates dynamic context if &lt;b&gt;action&lt;/b&gt; is equal to 1 (&lt;i&gt;parse (dyn instance)&lt;/i&gt;).</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">parsed</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if an input script was actually parsed. Otherwise, it returns FALSE that means the static context of the called VI instance already contains a parsed version of the input script.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Abort Script Execution.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI aborts execution of a running CSE script. In addition, the VI can be used to check up an abort trigger in a given CSE instance context.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">action</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is an optional parameter that specifies an operation to perform:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="trigger">The VI sets an abort trigger in the specified context and contexts of all the scripts involved in a call chain of the referenced script (a case when scripts call another scripts). It causes termination of execution of the referenced script as well as all the scripts involved in its call chain. This operation executes asynchronously with running script(s). This is default value.</EnumValue>
            <EnumValue ID="1" STR="reset">The VI resets an abort trigger in the specified context and returns its new state (FALSE).</EnumValue>
            <EnumValue ID="2" STR="check">The VI returns the current state of an abort trigger in the specified context.</EnumValue>
            <EnumValue ID="3" STR="flip">The VI resets an abort trigger in the specified context and returns the previous state of the trigger.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">triggered</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a state of an abort trigger.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Close Instance.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI closes a CSE instance context. If the context to be closed has been dynamically created by &lt;a href="hprj:CSE - Parse Script.vi"&gt;CSE - Parse Script.vi&lt;/a&gt;, the VI completely destroys it. If the context is static (i.e. it belongs to a CSE - Parse Script.vi instance), the VI reinitializes it with decreasing allocated memory.\n</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">destroyed</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if a dynamic CSE instance context has been destroyed. It contains FALSE if a static context has been reinitialized.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Not A CSE RefNum.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI validates a reference to CSE instance context.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">dynamically opened</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if &lt;b&gt;CSE RefNum&lt;/b&gt; refers to a dynamic CSE instance context.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Not a CSE RefNum</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if &lt;b&gt;CSE RefNum&lt;/b&gt; is an invalid reference.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Open Callback VI Reference.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI opens a VI reference to a CSE Callback VI, prepares it for execution, and saves its path for a further use. A Callback VI reference can then be passed to &lt;a href="hprj:CSE - Execute Parsed Script.vi"&gt;CSE - Execute Parsed Script.v&lt;/a&gt;i that will call the Callback VI to be under control of it.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">CSE calls a Callback VI through Call By Reference Node that requires a strictly typed VI refnum. On this reason, a Callback VI must have the same connector pane as &lt;b&gt;CSE Callback Template.vit&lt;/b&gt; supplied. A Callback VI can be either a regular VI or a VI template. If it is a VI template, a new unique instance of it will be created unless the template itself is already in memory. Use &lt;i&gt;"Tools &gt;&gt; CalcExpress &gt;&gt; Open CalcExpress Template..."&lt;/i&gt; menu to open the &lt;b&gt;CSE Callback Template.vit&lt;/b&gt;.\n\nIf you use this VI to open a reference to a Callback VI, a script called from another script has opportunity to inherit a path of the Callback VI from its caller. This way, all CSE instances involved in a call chain of the top-level script will use the same Callback VI (but different VI instances if it's either a VI template or a reentrant VI).\n</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">Callback VI Path</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an absolute path of CSE Callback VI to which a reference need be opened.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Window Title</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If you pass a non-empty string to it, the VI assigns the string to a window title of the Callback VI. It can be helpful when a Callback VI should work interactively.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Save w/o diagram (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If TRUE, the VI saves a Callback VI without the block diagram to a file in a system temporary directory and then deletes the file. This option can be reasonable when a Callback VI is a VI template. By default, &lt;b&gt;Save w/o diagram&lt;/b&gt; is FALSE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Callback VI RefNum</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a strictly typed VI refnum that contains a reference to the CSE Callback VI opened.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Script Path &amp; Search Paths.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI associates a parsed script with both a file path of the source script and a set of search directory paths. These paths are used to find target script files when the given script calls other scripts using relative paths.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">If any input path is relative, the VI converts it to the absolute path based on a directory path where the top-level VI in its call chain resides. If the top-level VI resides in a library or an executable program, an actual directory path is taken for the basis.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">script file path</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a file path to be associated with the given parsed script if &lt;b&gt;action&lt;/b&gt; control is equal to &lt;i&gt;save&lt;/i&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">search paths</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an array of search directory paths to be associated with the given parsed script if &lt;b&gt;action&lt;/b&gt; control is equal to &lt;i&gt;save&lt;/i&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">action</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an opetations to perform:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="get">The VI returns a script file path and array of search paths associated with the parsed script.</EnumValue>
            <EnumValue ID="1" STR="save">The VI associates &lt;b&gt;script file path&lt;/b&gt; and &lt;b&gt;search paths&lt;/b&gt; with the specified CSE instance context.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">script file path out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a path associated with the given parsed script.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">search paths out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a path associated with the given parsed script.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Diagnose Script.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns names of variables and functions referenced in a parsed &lt;a href="hprj:cse_syntax.html"&gt;CSE Script&lt;/a&gt;.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Diagnose Statement.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns names of variables and functions referenced in the specified statement of a parsed &lt;a href="hprj:cse_syntax.html"&gt;CSE Script&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">Stm Index</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a zero-based index of a desired statement. Maximum index is one less than number of statements in the parsed script (use &lt;a href="hprj:CSE - Get number of statements.vi"&gt;CSE - Get number of statements.vi&lt;/a&gt; to get number of statements). The VI doesn't produce an error if the index is out of range.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">expression</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if the specified statement contains an expression to be evaluated. Otherwise, it is equal to FALSE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Original List of Items</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a spread-sheet string with item names in order they are met in the statement of the script. For function, a function name is folowed by number of arguments in the function call.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Get number of statements.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns number of statements in a parsed CSE script. In addition, the VI returns a source script.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">number of statements</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns total number of statements in the specified parsed script.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Link Error to Source Script.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns information on the statement of a parsed CSE script on which either a syntax error was met or a runtime error occurred.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">statement info</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns information on a statement caused an error.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Stm Index</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns an index of the statement on which either a syntax error was met or a runtime error occurred. If no error was encountered, it contains -1.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dup error in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a flow-through parameter with the same value as error in. </Property>
          <Property Name="ClusterMembers">Disable</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">this VI error</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns error information of this VI.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">this VI error.status</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates an error status.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">this VI error.code</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates either a &lt;a href="hprj:errors.html"&gt;CalcExpress error code&lt;/a&gt; or a LabVIEW error code if any occurred. If no error occurred, it is equal to zero.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">this VI error.source</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates the error description and information on this VI location if an error occurred.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Error Message</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns an error description if either a syntax error was met or a runtime error occurred. It contains an empty string if no error was encountered.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Link Source Script Line to Statements.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns indexes of statements in a parsed CSE script that begin in the specified line of the source script.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">Line number (1)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a one-based line number in a source script (string). If &lt;b&gt;Line number&lt;/b&gt; is less than one or greater than number of lines in a source script, the VI returns an empty array in &lt;b&gt;Stm Indexes&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dup Line number</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;Line number&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Stm Indexes</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns indexes of statements in the parsed script that begin in &lt;b&gt;Line number&lt;/b&gt; line of the source script. &lt;b&gt;Stm Indexes&lt;/b&gt; contains an empty array if there is no statement beginning in the specified line.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Link Source Script Offset to Statement.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns an index of a statement in a parsed CSE script that is most appropriate to the specified offset (character position) in the source script.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">Offset (0)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an offset in a source script (string). If &lt;b&gt;Offset&lt;/b&gt; is less than zero, or is greater then or equal to the length of a source script string, the VI returns -1 in &lt;b&gt;Stm Index&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dup Offset</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;Offset&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Stm Index</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns an index of the statement in the parsed script that is most appropriate to the given offset in the source script. If the specified offset is not appropriate to any statement, &lt;b&gt;Stm Index&lt;/b&gt; returns -1.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Link Statement to Source Script.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns information on the specified statement of a parsed CSE script. In addition, the VI returns a source script of the parsed script.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">Stm Index</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies a zero-based index of a desired statement. Maximum index is one less than number of statements in the parsed script (&lt;b&gt;size&lt;/b&gt; indicator, or use &lt;a href="hprj:CSE - Get number of statements.vi"&gt;CSE - Get number of statements.vi&lt;/a&gt;). The VI doesn't produce an error if the index is out of range.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">size</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns total number of statements in the parsed script.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get DBL argument as 1D Array.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI returns value of a function argument transformed to 1D array of DBL values. An input argument must be a DBL scalar, or 1D or 2D array thereof. If the argument is a name of varible, the VI returns a value and data type of the variable.\n</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs.\nThe VI verifies number of arguments, which must be in the specified range. If the VI detects any error, it returns an error status and posts the error description to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;. A CalcExpress VI returns the error description when it completes evaluating the expression.\n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. </Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">permissions</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies data types allowed</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">permissions.scalar enabled</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">&lt;a href="hprj:dtypes.html#data_types_predefined"&gt;DBL Number&lt;/a&gt; is allowed (TRUE by default).</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">permissions.1d array enabled</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">&lt;a href="hprj:dtypes.html#data_types_predefined"&gt;1D Array of DBL&lt;/a&gt; is allowed (TRUE by default).</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">permissions.2d array enabled</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">&lt;a href="hprj:dtypes.html#data_types_predefined"&gt;2D Array of DBL&lt;/a&gt; is allowed (TRUE by default).</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">1D data</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the argument value as 1D array of DBL values.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">category</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the argument category:</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="scalar"/>
            <EnumValue ID="1" STR="1D array"/>
            <EnumValue ID="2" STR="2D array"/>
            <EnumValue ID="3" STR="ERROR"/>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">arg type</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns actual data type code of the argument. If the argument is a variable name, &lt;b&gt;type&lt;/b&gt; contains a data type of the variable.</Property>
          <Property Name="EnumValues">Disable</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="String"/>
            <EnumValue ID="1" STR="DBL Number"/>
            <EnumValue ID="2" STR="identifier"/>
            <EnumValue ID="3" STR="1D Array of DBL"/>
            <EnumValue ID="4" STR="2D Array of DBL"/>
            <EnumValue ID="5" STR="CDB Number"/>
            <EnumValue ID="6" STR="1D Array of CDB"/>
            <EnumValue ID="7" STR="2D Array of CDB"/>
            <EnumValue ID="8" STR="1D Array of String"/>
            <EnumValue ID="9" STR="2D Array of String"/>
            <EnumValue ID="10" STR="Unknown data type"/>
          </Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VHistUtils.llb\VHist - Multiple DBL history to spreadsheet string.vi">
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">history headers</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">Defines header strings for historical data series; e.g. variable names.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">time stamp header</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">Defines a header string for timestamp series.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">spreadsheet string</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the resulting string.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VHistUtils.llb\VHist - Multiple DBL history to Table.vi">
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">transpose (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">If TRUE, &lt;b&gt;table data&lt;/b&gt; array is transposed.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">time stamp headers</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns 1D array that represents timestamps as strings in the given format.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">table data</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns 2D array that represents historical data as strings in the given format.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Variables Writer ID.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI presets or reads the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; value applied to variable write operations executed by the given CalcExpress instance.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">Every CalcExpress instance holds its own &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; value, which is passed to VarMan during variable write operations. This value is initialized to 0 when the instance is created, but it can be altered before execution using this VI, or during script execution using the &lt;HTML&gt;&lt;span class="FixedFont"&gt;&lt;a href="cefunc_vm2.html#cef_vwrid"&gt;vwrid()&lt;/a&gt;&lt;/span&gt;&lt;/HTML&gt; function. A new value stays unchanged until it is explicitly altered again.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">writer ID in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the new value to preset. This value is only used if the &lt;b&gt;set (F)&lt;/b&gt; control is TRUE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">writer ID out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the actual Writer ID value of the CalcExpress instance if the &lt;b&gt;set (F)&lt;/b&gt; control is FALSE, or the previous value if &lt;b&gt;set (F)&lt;/b&gt; is TRUE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">set (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">defines the action to perform. If FALSE (default), the VI returns the actual writer ID; otherwise, it sets a new value provided by the &lt;b&gt;writer ID in&lt;/b&gt; control.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Variables Writer ID.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">The VI presets or reads the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; value applied to variable write operations executed by the given CSE instance.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">Every CSE instance holds its own &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; value, which is passed to VarMan during variable write operations. This value is initialized to 0 when the instance is created, but it can be altered before execution using this VI, or during script execution using the &lt;HTML&gt;&lt;span class="FixedFont"&gt;&lt;a href="cefunc_vm2.html#cef_vwrid"&gt;vwrid()&lt;/a&gt;&lt;/span&gt;&lt;/HTML&gt; function. A new value stays unchanged until it is explicitly altered again.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">writer ID in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the new value to preset. This value is only used if the &lt;b&gt;set (F)&lt;/b&gt; control is TRUE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">writer ID out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the actual Writer ID value of the CSE instance if the &lt;b&gt;set (F)&lt;/b&gt; control is FALSE, or the previous value if &lt;b&gt;set (F)&lt;/b&gt; is TRUE.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">set (F)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">defines the action to perform. If FALSE (default), the VI returns the actual writer ID; otherwise, it sets a new value provided by the &lt;b&gt;writer ID in&lt;/b&gt; control.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Error Status to Error Cluster.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Converts a Boolean error status, which some FuncVI support VIs return, to the standard LabVIEW error cluster.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs. </Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">error status in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an input error status.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error status out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates an output error status.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Unflatten Error Handler (Error Cluster).vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">This VI handles an error produced by the &lt;b&gt;Unflatten From String&lt;/b&gt; LabVIEW function.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs. \nA FuncVI obtains an argument value in the Flattened-To-String format if the argument type is either one of Complex types or a user-defined &lt;a href="hprj:dtypes.html"&gt;data type&lt;/a&gt;. The VI tests an error condition returned by the &lt;u&gt;Unflatten From String&lt;/u&gt; LabVIEW function, which is used to convert an argument value from the Flattened-To-String format to its native format. If a conversion error status is passed to the VI, it posts the error description to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;.\n\nThis type of error is atypical. It cannot occur unless a specified argument type mismatches its flattened data. Care must be taken wherever a user-defined data type is bound with flattened data; for example, when returning a FuncVI result.\n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. </Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is not used.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dup name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">duplicates a value of &lt;b&gt;name&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">argument number</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the one-based number of the function argument on which the &lt;u&gt;Unflatten From String&lt;/u&gt; error occurred. This value is used to format the error description. If it is less than 1, the argument number will be omitted from the error description.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">error status before</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies an error status that could occur before the relevant &lt;u&gt;Unflatten From String&lt;/u&gt; function call.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Unflatten Error Cluster</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">can accept error information wired from the &lt;u&gt;Unflatten From String&lt;/u&gt; function previously called. </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Unflatten Error Cluster.status</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates error status.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Unflatten Error Cluster.code</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains error code.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Unflatten Error Cluster.source</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains additional error information.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - VarMan VI Error Cluster to Func Result Value.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">This VI converts an error returned by a VarMan VI to the value returned by a FuncVI function.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">VarMan VI error in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">can accept error information wired from a &lt;a href="hprj:vm-top.mnu"&gt;VarMan VI&lt;/a&gt; previously called. </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VarMan VI error in.status</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates error status.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VarMan VI error in.code</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains error code.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VarMan VI error in.source</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains additional error information.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">CE Function Result Value</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns a VarMan Engine error code if &lt;b&gt;VarMan VI error in&lt;/b&gt; signals an error. This terminal can be wired directly to the &lt;b&gt;num&lt;/b&gt; member in the &lt;b&gt;result&lt;/b&gt; cluster of a FuncVI.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - VarMan Error Handler (Error Cluster).vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">This VI handles errors produced by &lt;a href="hprj:vm-top.mnu"&gt;VarMan VIs&lt;/a&gt;.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI is intended for use in FuncVIs.\nIf a VarMan VI indicates that an error occurred while executing, this VI posts the error description to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;. \n\nFor details, see the &lt;a href="hprj:ce_funcvi.html"&gt;FuncVI Development&lt;/a&gt; topic. Also see &lt;a href="hprj:ce_funcvi_examples.html#cevi_exmpl_aargs"&gt;Example of use&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">var name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the variable name on which a &lt;a href="hprj:vm-top.mnu"&gt;VarMan VI&lt;/a&gt; operated. The VI uses this variable name to format an error message if an error occurred during the operation.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">dup var name</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;var name&lt;/b&gt;.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VarMan VI error in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">can accept error information wired from a &lt;a href="hprj:vm-top.mnu"&gt;VarMan VI&lt;/a&gt; previously called. </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VarMan VI error in.status</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates error status.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VarMan VI error in.code</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains error code.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">VarMan VI error in.source</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains additional error information.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">FuncVI error out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates an error status. It can be wired directly to the &lt;b&gt;error out&lt;/b&gt; indicator of a FuncVI.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 1D Array of CDB.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;1D Array of CDB&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. This VI provides the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; functionality.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 1D Array of DBL.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;1D Array of DBL&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. This VI provides the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; functionality.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 1D Array of Strings.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;1D Array of Strings&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. This VI provides the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; functionality.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 2D Array of CDB.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;2D Array of CDB&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. This VI provides the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; functionality.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 2D Array of DBL.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;2D Array of DBL&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. This VI provides the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; functionality.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 2D Array of Strings.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;2D Array of Strings&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. This VI provides the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; functionality.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - CDB Scalar.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;CDB Number&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. This VI provides the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; functionality.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - DBL Scalar.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;DBL Number&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. This VI provides the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; functionality.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - String.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of the &lt;b&gt;String&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;. This VI provides the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; functionality.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Arbitrary Data.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Manages VarMan variables of an arbitrary data type; both &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;predefined&lt;/a&gt; and &lt;a href="hprj:dtypes.html#data_types_user_defined"&gt;user-defined&lt;/a&gt; data types are supported. This VI provides the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; functionality.</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">The VI accepts and returns variable values in the Flattened-To-String format, with the exception of the String type, whose values are passed as native LabVIEW strings. For predefined data types, the VI checks the consistency of the data type code and value format, and it returns an error in case of a mismatch.\n\nAlso see &lt;a href="hprj:varman.html"&gt;VarMan overview&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">flattened value in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the value to be written to the variable; it is only used if &lt;b&gt;cmd (read)&lt;/b&gt; is either &lt;i&gt;write&lt;/i&gt; or &lt;i&gt;create&lt;/i&gt;. Values of all data types are presented in the Flattened-To-String format, with the exception of the String type.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">flattened value out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the value that was read from the variable. Values of all data types are presented in the Flattened-To-String format, with the exception of the String type.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">var type in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the data type code of the target variable. VarMan strictly enforces data type codes. However, an application can pass -1 to this input to read a variable value of an arbitrary data type, in which case &lt;b&gt;var type out&lt;/b&gt; returns the actual data type code. Passing a data type code of -1 during &lt;i&gt;write&lt;/i&gt; or &lt;i&gt;create&lt;/i&gt; operations will cause the VI to return an error.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">var type out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the actual data type code.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Variable Data Info.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Returns information about the specified variable and its value.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">var type</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the &lt;a href="hprj:dtypes.html"&gt;data type&lt;/a&gt; of the specified variable.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">has history</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns TRUE if the specified variable has a history attached.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">create stats</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns information about the variable creation:</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">create stats.creator ID</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; defined when the variable was created.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">create stats.create MS</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates the Milliseconds Timer value (the output of the &lt;b&gt;Tick Count (ms)&lt;/b&gt; primitive) when the variable was created.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">create stats.create TS</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates the time stamp (DBL representation), in the universal LabVIEW date/time format, when the variable was created.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Read Variables (DBL).vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Reads multiple VarMan variables of the &lt;b&gt;DBL Number&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Read Variables (ANY).vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Reads multiple VarMan variables of arbitrary &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data types&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">values out</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">returns the values of the specified variables. Each element of this array is a cluster with three members:</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">values out..datatype</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">indicates the &lt;a href="hprj:dtypes.html#data_types"&gt;data type&lt;/a&gt; code of the variable.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">values out..DBL</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains the variable value of the &lt;b&gt;DBL Number&lt;/b&gt; data type.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">values out..STR</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains the variable value for data types other than &lt;b&gt;DBL Number&lt;/b&gt;. The value is represented in the Flattened-To-String format, with the exception of the &lt;b&gt;String&lt;/b&gt; data type, whose values are passed as native LabVIEW strings. For predefined data types, the VI checks the consistency of the data type code and value format, and it returns an error in case of a mismatch.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Read Variables (STR).vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Reads multiple VarMan variables of the &lt;b&gt;String&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Write Variables (DBL).vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Writes multiple VarMan variables of the &lt;b&gt;DBL Number&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;.</Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Write Variables (ANY).vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Writes multiple VarMan variables of arbitrary &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data types&lt;/a&gt;.</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">values in</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">specifies the values to be written. This array must have the same size as &lt;b&gt;name_specs&lt;/b&gt;. Each element of this array is a cluster with three members:</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">values in..datatype</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">defines the &lt;a href="hprj:dtypes.html#data_types"&gt;data type&lt;/a&gt; code of the variable.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">values in..DBL</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains the variable value of the &lt;b&gt;DBL Number&lt;/b&gt; data type.</Property>
        </Item>
        <Item>
          <Property Name="CtrlID">values in..STR</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">contains the variable value for data types other than &lt;b&gt;DBL Number&lt;/b&gt;. The value is represented in the Flattened-To-String format, with the exception of the &lt;b&gt;String&lt;/b&gt; data type, whose values are passed as native LabVIEW strings. For predefined data types, the VI checks the consistency of the data type code and value format, and it returns an error in case of a mismatch.</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Write Variables (STR).vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">Writes multiple VarMan variables of the &lt;b&gt;String&lt;/b&gt; &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;data type&lt;/a&gt;.</Property>
    </ItemRule>
  </ItemRules>

  <HHP_Generation>
    <Property Name="HHP_Target_CustomPath">CE_Toolkit.hhp</Property>
    <Property Name="HHP_CreateTOC">TRUE</Property>
    <Property Name="HHP_CreateIDX">TRUE</Property>
    <Property Name="CHM_Filename">..\..\Help\CalcExpress\CEToolkit.chm</Property>
    <Property Name="CHM_AutoBuild">TRUE</Property>
  </HHP_Generation>

</VIHelpeksProject>
