      </Item>
      <Item Name="CE_Math" Type="Group">
        <GroupRule>
          <Property Name="VIDscrMode">Description1</Property>
          <Property Name="VIDetailsMode">Description2</Property>
        </GroupRule>
        <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Menus\cemath.mnu"/>
      </Item>
      <Item Name="CSE" Type="Group">
        <GroupRule>
          <Property Name="Control_Rules">
            <Item>
              <Property Name="CtrlID">CSE RefNum</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">is a reference number for a CSE instance that contains a parsed CSE script. &lt;a href="hprj:CSE - Parse Script.vi"&gt;CSE - Parse Script.vi&lt;/a&gt; returns a value that can be wired directly to this terminal.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">dup CSE RefNum</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;CSE RefNum&lt;/b&gt;.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">exec parameters</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">specifies optional parameters that affect execution of a script</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">exec parameters.pause counter</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">is the maximum number of statements the VI can complete before yielding execution control. Larger values increase script execution speed, while smaller values improve the responsiveness and execution rate of other VIs in the running thread. By default, &lt;b&gt;pause counter&lt;/b&gt; is equal to 1000.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">exec parameters.pause, ms</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">defines the number of milliseconds the VI is suspended after it executes the &lt;b&gt;pause counter&lt;/b&gt; statements. If this parameter is greater than or equal to zero, the VI uses it as an input value for the &lt;b&gt;Wait (ms)&lt;/b&gt; primitive. By default, &lt;b&gt;pause, ms&lt;/b&gt; is equal to zero.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">exec parameters.autoVar</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">enables (TRUE) or disables (FALSE) automatic (implicit) creating variables. If a left-hand operand in an Assignment operator is an identifier that does not refer to an existing variable, CalcExpress creates a variable with the such name to perform an assignment if only &lt;b&gt;autoVar&lt;/b&gt; is TRUE; otherwise an error is produced. Note that variables are created in a local variable context specified by &lt;b&gt;VC Handle&lt;/b&gt;. By default, &lt;b&gt;autoVar&lt;/b&gt; is TRUE.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">exec parameters.enCpx</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">enables (TRUE) or disables (FALSE) performing operators on operands of &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;Complex data types&lt;/a&gt; (suppress polymorphism feature). By default, &lt;b&gt;enCpx&lt;/b&gt; is TRUE.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">return value</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">is a value of expression in the &lt;a href="hprj:cse_syntax.html#cse_return"&gt;return statement&lt;/a&gt;. If a script finished without the return statement, &lt;b&gt;return value&lt;/b&gt; is zero.</Property>
            </Item>
          </Property>
        </GroupRule>
        <Item Name="CSE Core" Type="Group">
          <GroupRule/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Abort Script Execution.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Close Instance.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Execute Parsed Script.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Not A CSE RefNum.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Open Callback VI Reference.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Parse Script.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Script Path &amp; Search Paths.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Variables Writer ID.vi"/>
        </Item>
        <Item Name="Debugging" Type="Group">
          <GroupRule>
            <Property Name="Control_Rules">
              <Item>
                <Property Name="CtrlID">Items</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">specifies what names the VI is to return:</Property>
                <Property Name="EnumValDscr">
                  <EnumValue ID="0" STR="Variables">The VI returns variable names. It's default value.</EnumValue>
                  <EnumValue ID="1" STR="Functions">The VI returns function names (both FuncVI and FastFunc functions).</EnumValue>
                  <EnumValue ID="2" STR="FuncVI functions">The VI returns names of FuncVI functions only.</EnumValue>
                  <EnumValue ID="3" STR="FastFunc functions">The VI returns names of FastFunc functions only.</EnumValue>
                </Property>
              </Item>
              <Item>
                <Property Name="CtrlID">sort (F)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">specifies whether an output array of names need be sorted. If it is TRUE, elements in Array of Items are sorted in alphabetical case-insensitive order. Default value is FALSE.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">Array of Items</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">returns names of variables or functions requested. The array doesn't contain duplicate elements.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">dup Stm Index</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;Stm Index&lt;/b&gt;.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">get script source (T)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">If TRUE (by default), &lt;b&gt;script&lt;/b&gt; indicator returns a source script of the specified parsed script.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">script</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">returns a source script of the specified parsed script if &lt;b&gt;get script source&lt;/b&gt; control is equal to TRUE.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.CE InstanceRef</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">is a reference number of CalcExpress instance context that contains a parsed CalcExpress expression to evaluate. This value is only valid if &lt;b&gt;stmType&lt;/b&gt; is equal to 0 (&lt;i&gt;expression&lt;/i&gt;).</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.post action</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">indicates a kind of jump-action to perform after the statement completes.</Property>
                <Property Name="EnumValDscr">
                  <EnumValue ID="0" STR="jump">Set run position to &lt;b&gt;jump index&lt;/b&gt;.</EnumValue>
                  <EnumValue ID="1" STR="jump if true">Set run position to &lt;b&gt;jump index&lt;/b&gt; if expression is TRUE.</EnumValue>
                  <EnumValue ID="2" STR="jump if false">Set run position to &lt;b&gt;jump index&lt;/b&gt; if expression is FALSE.</EnumValue>
                  <EnumValue ID="3" STR="stop">finish script execution.</EnumValue>
                </Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.jump index</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">indicates an index of the next statement to perform. If &lt;b&gt;post action&lt;/b&gt; indicates a conditional jump, &lt;b&gt;jump index&lt;/b&gt; is effective if the condition is met during evaluation of the expression.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.stmType</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">indicates a type of the statement:</Property>
                <Property Name="EnumValDscr">
                  <EnumValue ID="0" STR="expression">An executable expression-statement to be evaluated.\n&lt;b&gt;statement info&lt;/b&gt; contains details on the statement location in a source script. The statement can be traced in a debugging mode.</EnumValue>
                  <EnumValue ID="1" STR="jump">An executable jump-statement, which doesn't contain an expression (e.g. &lt;i&gt;goto&lt;/i&gt; or &lt;i&gt;break&lt;/i&gt;).\n&lt;b&gt;statement info&lt;/b&gt; contains details on the statement location in a source script. The statement can be traced in a debugging mode.</EnumValue>
                  <EnumValue ID="2" STR="source ref">Non-executable statement, which can be referred in an error message.\n&lt;b&gt;statement info&lt;/b&gt; contains details on the statement location in a source script. The statement can be traced in a debugging mode.</EnumValue>
                  <EnumValue ID="3" STR="jump stub">An executable jump-statement implicitly added by the parser. It cannot be referred in an error message.\nThis statement doesn't have direct link to a source script. It executes always but it cannot be traced in a debugging mode.</EnumValue>
                  <EnumValue ID="4" STR="source stub">Non-executable statement, which can be referred in an error message.\n&lt;b&gt;statement info&lt;/b&gt; contains details on the statement location in a source script. It cannot be traced in a debugging mode. An example is an opening brace ( { ).</EnumValue>
                </Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.nesting level</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">indicates a nesting level of the statement in structures like &lt;i&gt;if&lt;/i&gt;, &lt;i&gt;for&lt;/i&gt;, &lt;i&gt;while&lt;/i&gt;. Zero value indicates the top level.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.stmOffset</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains an offset of the text-block in a source script associated with the statement.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.stmLength</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains length of the text-block in a source script associated with the statement.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.stmLine</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains a line number where the text-block in a source script associated with the statement begins. The first line has number one (1).</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.expOffset</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains an offset of an expression in a source script if &lt;b&gt;stmType&lt;/b&gt; is equal to 0 (&lt;i&gt;expression&lt;/i&gt;). Otherwise, it is equal to -1.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.expLength</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains a length of an expression in a source script if &lt;b&gt;stmType&lt;/b&gt; is equal to 0 (&lt;i&gt;expression&lt;/i&gt;). Otherwise, it is equal to 0.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.expLine</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains a line number where an expression begins in a source script if &lt;b&gt;stmType&lt;/b&gt; is equal to 0 (&lt;i&gt;expression&lt;/i&gt;). Otherwise, it is equal to -1. The first line has number one (1).</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">statement info.parent index</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains an index of the parent statement, or -1 if there is no a parent statement. This parameter is only applicable to expressions that are part of statements like &lt;i&gt;if&lt;/i&gt;, &lt;i&gt;for&lt;/i&gt;, &lt;i&gt;while&lt;/i&gt;.</Property>
              </Item>
            </Property>
          </GroupRule>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Diagnose Script.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Diagnose Statement.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Execute Script (Basic).vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Get number of statements.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Link Error to Source Script.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Link Source Script Line to Statements.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Link Source Script Offset to Statement.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\cse.llb\CSE - Link Statement to Source Script.vi"/>
        </Item>
        <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Menus\cse.mnu"/>
      </Item>
      <Item Name="VarMan" Type="Group">
        <GroupRule>
          <Property Name="Control_Rules">
            <Item>
              <Property Name="CtrlID">error out.code</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">contains &lt;a href="hprj:errors.html#err_vm_vi"&gt;VarMan VI error code&lt;/a&gt; identifying an error if any occurred. If no error occurred, it is equal to zero.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">error out.source</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">contains the error description and VI location information if an error occurred.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">err code</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">contains a &lt;a href="hprj:errors.html#err_vm_engine"&gt;VarMan Engine error code&lt;/a&gt; identifying an error. If no error occurred, &lt;b&gt;err code&lt;/b&gt; is equal to zero.</Property>
              <Property Name="EnumValues">Disable</Property>
              <Property Name="EnumValDscr">
                <EnumValue ID="0" STR="No error"/>
                <EnumValue ID="1" STR="Invalid variable type"/>
                <EnumValue ID="2" STR="Variable not found"/>
                <EnumValue ID="3" STR="Variable already exists"/>
                <EnumValue ID="4" STR="Invalid context handle"/>
                <EnumValue ID="5" STR="Input error"/>
                <EnumValue ID="6" STR="Invalid data format"/>
                <EnumValue ID="7" STR="No history attached"/>
                <EnumValue ID="8" STR="History already attached"/>
                <EnumValue ID="9" STR="Invalid history parameters"/>
                <EnumValue ID="10" STR="Wrong variable name"/>
                <EnumValue ID="11" STR="Wrong alias name"/>
                <EnumValue ID="12" STR="Non-unique alias"/>
                <EnumValue ID="13" STR="Alias not found"/>
                <EnumValue ID="14" STR="No alias associated"/>
                <EnumValue ID="15" STR="Alias already associated"/>
                <EnumValue ID="16" STR="Wrong context name"/>
                <EnumValue ID="17" STR="Non-unique context name"/>
                <EnumValue ID="18" STR="Context name not found"/>
                <EnumValue ID="19" STR="Invalid parameter"/>
                <EnumValue ID="20" STR="Generic error"/>
                <EnumValue ID="21" STR="Memory Full"/>
                <EnumValue ID="22" STR="Unrecognized LV error"/>
                <EnumValue ID="23" STR="Unknown error code"/>
              </Property>
            </Item>
            <Item>
              <Property Name="CtrlID">dup VC Handle</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;VC Handle&lt;/b&gt;.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">name_spec</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">defines the name specifier of the target variable. Usually, this is merely a variable name; however, additional options are available. See the &lt;a href="hprj:varman_vref.html"&gt;Referring to variables&lt;/a&gt; topic for details.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">dup name_spec</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;name_spec&lt;/b&gt;.</Property>
            </Item>
          </Property>
        </GroupRule>
        <Item Name="Context &amp; Misc" Type="Group">
          <GroupRule/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Close Context.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Close loose contexts.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Context Info.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Context Names.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Get list of contexts.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Initializing.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Not a VC Handle.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Open Context.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Type Code to CalcExpress Data Type.vi"/>
        </Item>
        <Item Name="Variable Control" Type="Group">
          <GroupRule>
            <Property Name="Control_Rules">
              <Item>
                <Property Name="CtrlID">VC Handle</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">specifies the handle of the Variable Context in which to operate on the variable. &lt;b&gt;VC Handle&lt;/b&gt; is ignored if &lt;b&gt;name_spec&lt;/b&gt; refers to the variable by an alias. See the &lt;a href="hprj:varman_vref.html"&gt;Referring to variables&lt;/a&gt; topic for more information.\nThe &lt;a href="hprj:VM - Open Context.vi"&gt;VM - Open Context.vi&lt;/a&gt; creates a Variable Context and returns its handle.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">cmd</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">specifies the operation to execute:</Property>
                <Property Name="EnumValDscr">
                  <EnumValue ID="0" STR="create">creates a variable</EnumValue>
                  <EnumValue ID="1" STR="destroy">destroys a variable</EnumValue>
                  <EnumValue ID="2" STR="set value">writes a variable value</EnumValue>
                  <EnumValue ID="3" STR="get value">reads the variable value (default operation)</EnumValue>
                </Property>
              </Item>
              <Item>
                <Property Name="CtrlID">global? (F)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description"> controls access to global variables; its function is a little different for different operations.\n*) It is ignored if &lt;b&gt;name_spec&lt;/b&gt; refers to a variable by an alias and &lt;b&gt;cmd&lt;/b&gt; is not &lt;i&gt;create&lt;/i&gt;.\n*) If &lt;b&gt;cmd&lt;/b&gt; is either &lt;i&gt;create&lt;/i&gt; or &lt;i&gt;destroy&lt;/i&gt;, &lt;b&gt;global&lt;/b&gt; exactly specifies either local (FALSE) or global (TRUE) variable needs to be operated.\n*) If &lt;b&gt;cmd&lt;/b&gt; is either &lt;i&gt;set value&lt;/i&gt; or &lt;i&gt;get value&lt;/i&gt;, &lt;b&gt;global&lt;/b&gt; influences ability to access global variables. VarMan never searches for global variables if &lt;b&gt;globa&lt;/b&gt;l is FALSE. If &lt;b&gt;global&lt;/b&gt; is TRUE and VarMan cannot find the specified variable in &lt;b&gt;VC Handle&lt;/b&gt; context, it tries to find the variable in the global context. In order to make VarMan looks for global variables only, provide &lt;b&gt;global&lt;/b&gt; is TRUE and &lt;b&gt;VC Handle&lt;/b&gt; is equal to -1 (or keep it unwired).\n</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">value in</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">defines a value to be assigned to the specified variable if either the &lt;i&gt;create&lt;/i&gt; or the &lt;i&gt;set value&lt;/i&gt; operation is to be performed.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">value out</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">returns the value of the specified variable if the &lt;i&gt;get value&lt;/i&gt; operation was performed; otherwise, it returns the same value as &lt;b&gt;value in&lt;/b&gt;.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">global out</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">returns TRUE if an operation has been performed on a global variable; otherwise, it returns FALSE.</Property>
              </Item>
            </Property>
          </GroupRule>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 1D Array of CDB.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 1D Array of DBL.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 1D Array of Strings.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 2D Array of CDB.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 2D Array of DBL.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - 2D Array of Strings.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Alias Controller.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Arbitrary Data.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - CDB Scalar.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - DBL Scalar.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Destroy Variable.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - List of Aliases.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - List of Variables.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Strings.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Variable Attribute.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM - Variable Info.vi"/>
        </Item>
        <Item Name="Variable History" Type="Group">
          <GroupRule>
            <Property Name="Control_Rules">
              <Item>
                <Property Name="CtrlID">VC Handle</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">specifies the handle of the Variable Context in which the target variable exists. To operate on a global variable, pass -1 to this input or keep it unwired. &lt;b&gt;VC Handle&lt;/b&gt; is ignored if &lt;b&gt;name_spec&lt;/b&gt; refers to the variable by an alias. See the &lt;a href="hprj:varman_vref.html"&gt;Referring to variables&lt;/a&gt; topic for more information.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">N vals (all)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">is used only if the &lt;b&gt;mode&lt;/b&gt; control is equal to &lt;i&gt;N-Vals (1)&lt;/i&gt;; otherwise, it is ignored. &lt;b&gt;N vals&lt;/b&gt; specifies the desired number of newest history values to be returned. If &lt;b&gt;N vals&lt;/b&gt; is greater than or equal to zero, and less than the actual number of values stored in the history, the VI returns &lt;b&gt;N vals&lt;/b&gt; last values stored in the history. Otherwise, VI returns all history values. By default, &lt;b&gt;N vals&lt;/b&gt; is equal to -1; i.e. VI returns the entire history.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">time range (all)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">cluster is used only if the &lt;b&gt;mode&lt;/b&gt; control is equal to &lt;i&gt;TimeRange (0)&lt;/i&gt;; otherwise, it is ignored. If both the &lt;b&gt;t1&lt;/b&gt; and &lt;b&gt;t2&lt;/b&gt; members of the cluster are equal to zero (default), the VI returns the entire history of the specified variable. Otherwise, the VI returns only values whose time stamps fall within the range from MIN(&lt;b&gt;t1&lt;/b&gt;,&lt;b&gt;t2&lt;/b&gt;) up to MAX(&lt;b&gt;t1&lt;/b&gt;,&lt;b&gt;t2&lt;/b&gt;).</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">time range (all).t1</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">defines the first boundary of a time range.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">time range (all).t2</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">defines the second boundary of a time range.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">mode</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">specifies the behavior of the VI. There are the following modes:</Property>
                <Property Name="EnumValDscr">
                  <EnumValue ID="0" STR="TimeRange">VI returns history values that have time stamps in the range specified in &lt;b&gt;time range&lt;/b&gt; cluster. It's default value.</EnumValue>
                  <EnumValue ID="1" STR="N-Vals">VI returns as many newest history values as specified in &lt;b&gt;N vals&lt;/b&gt; control, or entire history if number of stored values is less than &lt;b&gt;N Vals&lt;/b&gt;.</EnumValue>
                  <EnumValue ID="2" STR="NewVals">VI returns only values stored to the history after it was successfully read in &lt;i&gt;NewVals&lt;/i&gt; mode last time. If no values have been added to the history after the last such reading, VI returns no values (empty history subset).</EnumValue>
                </Property>
              </Item>
              <Item>
                <Property Name="CtrlID">reverse order (T)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">If it equals TRUE (default), the VI returns values arranged in reverse chronological order (decreasing time stamps). If it equals FALSE, the VI returns values arranged in direct chronological order (increasing time stamps).</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">time stamps</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">is an array of the time stamps (DBL representation), in the universal LabVIEW date/time format, for the respective elements in the &lt;b&gt;history&lt;/b&gt; indicator.  Elements in the &lt;b&gt;time stamps&lt;/b&gt;, &lt;b&gt;history&lt;/b&gt;, and &lt;b&gt;writer IDs&lt;/b&gt; arrays are arranged in the order specified by the &lt;b&gt;reverse order&lt;/b&gt; control.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">history</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">is an array containing the historic variable values.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">history..data</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">An element of the &lt;b&gt;history&lt;/b&gt; array is a cluster with a single member that contains the historic variable value.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">writer IDs</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">is an array containing the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer IDs&lt;/a&gt; for the respective elements in the &lt;b&gt;history&lt;/b&gt; indicator, signaling the source of those historic values. This array is empty if the variable history does not maintain Writer IDs.</Property>
              </Item>
            </Property>
          </GroupRule>
          <Item Name="Control" Type="Group">
            <GroupRule>
              <Property Name="Control_Rules">
                <Item>
                  <Property Name="CtrlID">history info</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">is a cluster with information on configuration and state of the variable history.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.var type</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the &lt;a href="hprj:dtypes.html"&gt;data type&lt;/a&gt; code of the specified variable.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.history length</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the maximum number of variable values that can be stored in the history.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.stored values</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the actual number of variable values stored in the history. This value cannot exceed the &lt;b&gt;history length&lt;/b&gt;.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.update cnt</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">is an incremental counter that contains the total number of values written to the history since it was created. Every time VarMan adds a value to the history, it increments &lt;b&gt;update cnt&lt;/b&gt; counter. This value can exceed the &lt;b&gt;history length&lt;/b&gt;.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.last update ms</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the Millisecond Timer value (the output of the &lt;b&gt;Tick Count (ms)&lt;/b&gt; primitive) when the most recent value was saved to the history.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.newest timestamp</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the time stamp, in seconds, of the most recent value in the history.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.oldest timestamp</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the time stamp, in seconds, of the oldest value stored in the history.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.NewVals mode</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">is a cluster with parameters specific for reading a history in the &lt;i&gt;NewVals&lt;/i&gt; mode.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.NewVals mode.NewVals cnt</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">is an incremental counter that contains the number of values saved to the history since it was last read in the &lt;i&gt;NewVals&lt;/i&gt; mode. VarMan increments the counter every time it adds a value to the history and zeroes the counter when the history is read in &lt;i&gt;NewVals&lt;/i&gt; mode. This value can exceed the history length.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.NewVals mode.last read time</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">contains time stamp, in seconds, of the last value that has been read in &lt;i&gt;NewVals&lt;/i&gt; mode. In fact, VarMan sets this parameter to the current value of the &lt;b&gt;newest timestamp&lt;/b&gt; when the history is read in &lt;i&gt;NewVals&lt;/i&gt; mode.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.NewVals mode.last read ms</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">contains time stamp, in millisecond timer's values, of the last value that has been read in &lt;i&gt;NewVals&lt;/i&gt; mode. In fact, VarMan sets this parameter to the current value of &lt;b&gt;last update ms&lt;/b&gt; when the history is read in &lt;i&gt;NewVals&lt;/i&gt; mode.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.time condition</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">contains parameters of &lt;b&gt;time conditions&lt;/b&gt; used for maintaining the history. See &lt;a href="hprj:varman_vhist.html#vhistory_overview_update_tc"&gt;Updating history, Time condition&lt;/a&gt; topic for details.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.time condition.Step, ms</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates a time step, in milliseconds, to update the history.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.time condition.Gate, ms</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates a time gate, in milliseconds, to overwrite the last value in the history.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.value condition</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">contains parameters of &lt;b&gt;value condition&lt;/b&gt; used for maintaining the history. See &lt;a href="hprj:varman_vhist.html#vhistory_overview_update_vc"&gt;Updating history, Value conditions&lt;/a&gt; topic for details on how it works.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.value condition.condition</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the kind of condition:</Property>
                  <Property Name="EnumValDscr">
                    <EnumValue ID="0" STR="don't test"/>
                    <EnumValue ID="1" STR="changed"/>
                    <EnumValue ID="2" STR="abs deviation"/>
                    <EnumValue ID="3" STR="rel deviation"/>
                    <EnumValue ID="4" STR="out of range"/>
                    <EnumValue ID="5" STR="within range"/>
                  </Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.value condition.Delta</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the &lt;b&gt;Delta&lt;/b&gt; parameter of the value condition.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.value condition.Range_Min</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the &lt;b&gt;Range_Min&lt;/b&gt; parameter of the value condition.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history info.value condition.Range_Max</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the &lt;b&gt;Range_Max&lt;/b&gt; parameter of the value condition.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">more data</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">contains additional information about the history.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">more data.store Writer IDs</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates whether the history maintains &lt;a href="varman.html#varman_overview_wrid"&gt;Writer IDs&lt;/a&gt;.</Property>
                </Item>
              </Property>
            </GroupRule>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - History Controller.vi"/>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - History Info.vi"/>
          </Item>
          <Item Name="Preset" Type="Group">
            <GroupRule>
              <Property Name="Control_Rules">
                <Item>
                  <Property Name="CtrlID">time stamps</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">passes the time stamps (DBL representation), in the universal LabVIEW date/time format, for the respective elements in the &lt;b&gt;history&lt;/b&gt; control. The number of elements in the &lt;b&gt;time stamps&lt;/b&gt; array must match the number of elements in the &lt;b&gt;history&lt;/b&gt; array.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">passes the variable history values. The number of elements in the &lt;b&gt;history&lt;/b&gt; array must match the number of elements in the &lt;b&gt;time stamps&lt;/b&gt; array.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">append (F)</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">specifies whether the input data appends to the current history or overrides the existing content of the variable history (default).</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">writer IDs</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">specifies the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer IDs&lt;/a&gt; for the respective elements in &lt;b&gt;history&lt;/b&gt;. If the history does not maintain Writer IDs, this input is ignored. If the size of this array is less than the size of &lt;b&gt;history&lt;/b&gt; and &lt;b&gt;time stamps&lt;/b&gt;, its first element is bound to all new history values. If this array is empty, zero (0) is used.</Property>
                </Item>
              </Property>
            </GroupRule>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Preset CDB Scalar History.vi"/>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Preset DBL Scalar History.vi"/>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Preset STR History.vi"/>
          </Item>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 1D Array of CDB History.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 1D Array of DBL History.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 1D Array of STR History.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 2D Array of CDB History.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 2D Array of DBL History.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get 2D Array of STR History.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get Arbitrary Variable History.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get CDB Scalar History.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get DBL Scalar History.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\vHistory.llb\VHistory - Get STR History.vi"/>
        </Item>
        <Item Name="Variable History Utility" Type="Group">
          <GroupRule>
            <Property Name="VIDscrMode">Description</Property>
            <Property Name="VIDetailsMode">None</Property>
            <Property Name="Control_Rules">
              <Item>
                <Property Name="CtrlID">error out.code</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains error code.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">error out.source</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains additional error information.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">new time stamps</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Array of new timestamps historical data need be fitted to.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">time stamps</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Array of timestamps for respective elements in &lt;b&gt;history data&lt;/b&gt;.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">history data</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Array of historical values.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">time condition</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">cluster specifies parameters to generate new array of time stamps.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">time condition.From</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">defines initial timestamp of a time range.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">time condition.To</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">defines final timestamp of a time range.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">time condition.step, sec</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">defines time interval.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">NaN for absent (F)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">If TRUE, the VI outputs NaN for absent values. If FALSE (by default), the VI uses either the last known value or determines value by interpolation (if enabled by &lt;b&gt;interpolate&lt;/b&gt; control.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">interpolate (F)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">If TRUE and &lt;b&gt;NaN for absent&lt;/b&gt; is FALSE, the VI determines absent values by linear interpolation.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">empty for absent (T)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">If TRUE (by default), the VI outputs empty string for absent values. If FALSE, the VI uses the last known value.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">merge data (T)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">If TRUE, the VI merges values comming in between adjacent new time stamps; otherwise, it uses the last known value.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">time stamps out</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Array of new timestamps to which historical data are fitted.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">history data out</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Array of historical values fitted to new timestamps in the &lt;b&gt;time stamps out&lt;/b&gt;.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">history array</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Array of clusters that contains information on historical data.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">history array..time stamps</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Array of timestamps for respective elements in &lt;b&gt;history data&lt;/b&gt;.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">history array..history data</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Array of historical values.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">multiple history data out</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Array of clusters that returns new historical data.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">multiple history data out..history data</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Array of historical values fitted to new timestamps in the &lt;b&gt;time stamps out&lt;/b&gt;.</Property>
              </Item>
            </Property>
          </GroupRule>
          <Item Name="More" Type="Group">
            <GroupRule>
              <Property Name="VIDscrMode">Description1</Property>
              <Property Name="VIDetailsMode">None</Property>
              <Property Name="Control_Rules">
                <Item>
                  <Property Name="CtrlID">time stamps</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">Array of timestamps for respective elements in &lt;b&gt;history data&lt;/b&gt;.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">multiple history data</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">Array of clusters that contains multiple history data.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">multiple history data..history data</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">Array of historical values.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">time stamp (0: now)</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">specifies timestamp to which a new historical value is to be inserted.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">method (linear)</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">specifies a method to determine new value while interpolating or extrapolating.</Property>
                  <Property Name="EnumValDscr">
                    <EnumValue ID="0" STR="linear"/>
                    <EnumValue ID="1" STR="spline"/>
                    <EnumValue ID="2" STR="polynominal"/>
                    <EnumValue ID="3" STR="rational"/>
                  </Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">time stamps out</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">Array of new timestamps.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">history data out</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">Array of new historical values respective to new timestamps in the &lt;b&gt;time stamps out&lt;/b&gt;.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">multiple history data out</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">Array of clusters that returns new historical data.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">multiple history data out..history data</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">Array of new historical values respective to new timestamps in the &lt;b&gt;time stamps out&lt;/b&gt;.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">time stamp format (%c)</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">specifies timestamp format.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">data format (%.3f)</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">specifies numeric values format.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">empty for NaN (F)</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">If TRUE, NaN values are not shown.</Property>
                </Item>
              </Property>
            </GroupRule>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VHistUtils.llb\VHist - Interpolate DBL History.vi"/>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VHistUtils.llb\VHist - Interpolate multi DBL History.vi"/>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VHistUtils.llb\VHist - Multiple DBL history to spreadsheet string.vi"/>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VHistUtils.llb\VHist - Multiple DBL history to Table.vi"/>
          </Item>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VHistUtils.llb\VHist - Fit DBL history to new timestamps.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VHistUtils.llb\VHist - Fit multi DBL history to new timestamps.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VHistUtils.llb\VHist - Fit multi STR history to new timestamps.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VHistUtils.llb\VHist - Fit STR history to new timestamps.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VHistUtils.llb\VHist - Time Range from history array.vi"/>
        </Item>
        <Item Name="Variable WRID" Type="Group">
          <GroupRule>
            <Property Name="Control_Rules">
              <Item>
                <Property Name="CtrlID">VC Handle</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">specifies the handle of the Variable Context in which to operate on the variable. To operate on a global variable, pass -1 to this input. &lt;b&gt;VC Handle&lt;/b&gt; is ignored if &lt;b&gt;name_spec&lt;/b&gt; refers to the variable by an alias. See the &lt;a href="hprj:varman_vref.html"&gt;Referring to variables&lt;/a&gt; topic for more information.\nThe &lt;a href="hprj:VM - Open Context.vi"&gt;VM - Open Context.vi&lt;/a&gt; creates a Variable Context and returns its handle.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">cmd (read)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">specifies the operation to execute:</Property>
                <Property Name="EnumValDscr">
                  <EnumValue ID="0" STR="create">creates a variable</EnumValue>
                  <EnumValue ID="1" STR="destroy">destroys a variable</EnumValue>
                  <EnumValue ID="2" STR="write">writes a variable value</EnumValue>
                  <EnumValue ID="3" STR="read">reads the variable value (default operation)</EnumValue>
                </Property>
              </Item>
              <Item>
                <Property Name="CtrlID">value in</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">defines a value to be assigned to the specified variable if either the &lt;i&gt;create&lt;/i&gt; or the &lt;i&gt;write&lt;/i&gt; operation is to be performed.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">value out</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">returns the value of the specified variable if the &lt;i&gt;read&lt;/i&gt; operation was performed; otherwise, it returns the same value as &lt;b&gt;value in&lt;/b&gt;.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">writer ID</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">specifies the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; for the input value. It is only used during the &lt;i&gt;write&lt;/i&gt; or the &lt;i&gt;create&lt;/i&gt; operations.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">stats</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">returns information about the most recent value of the variable.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">stats.writer ID</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">indicates the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; for the most recent value.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">stats.write MS</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">indicates the Milliseconds Timer value (the output of the &lt;b&gt;Tick Count (ms)&lt;/b&gt; primitive) when the variable value was written.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">stats.write TS</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">indicates the time stamp (DBL representation), in the universal LabVIEW date/time format, when the variable value was written.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">stats.write Cnt</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">indicates the variable's write counter. This counter starts at zero (0) when the variable is created and increments every time the variable is written.</Property>
              </Item>
            </Property>
          </GroupRule>
          <Item Name="R/W Multiple" Type="Group">
            <GroupRule>
              <Property Name="Control_Rules">
                <Item>
                  <Property Name="CtrlID">VC Handle</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">specifies the handle of the Variable Context in which the target variables exist. To operate on global variables, pass -1 to this input. This input is ignored for any element in the &lt;b&gt;name_specs&lt;/b&gt; array that refers to a variable by an alias.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">name_specs</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">defines the name specifiers of the target variables. Usually, a name specifier is merely a variable name; however, additional options are available. See the &lt;a href="hprj:varman_vref.html"&gt;Referring to variables&lt;/a&gt; topic for details.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">dup name_specs</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;name_specs&lt;/b&gt;.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">writer IDs</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">specifies the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer IDs&lt;/a&gt; for the respective elements in &lt;b&gt;name_specs&lt;/b&gt; and &lt;b&gt;values&lt;/b&gt;. If the size of this array is less than the size of &lt;b&gt;name_specs&lt;/b&gt;, its first element is bound to all values. If this array is empty, zero (0) is used.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">atomic (F)</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">guarantees, if TRUE, that the operation on all variables is executed in a single, atomic transaction. This prevents other VIs or threads from modifying the variables during execution.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">values in</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">specifies the variable values to be written. This array must have the same size as &lt;b&gt;name_specs&lt;/b&gt;.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">values out</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">returns the values of the specified variables.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">errCodes</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">returns &lt;a href="hprj:errors.html#err_vm_engine"&gt;VarMan Engine error codes&lt;/a&gt; individually for each variable. If any element in this array is non-zero, the &lt;b&gt;error out&lt;/b&gt; cluster returns the corresponding error description.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">stats</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">returns additional information about the variable values. Each element of this array is a cluster with the following members:</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">stats..writer ID</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the &lt;a href="varman.html#varman_overview_wrid"&gt;Writer ID&lt;/a&gt; for the most recent value.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">stats..write MS</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the Milliseconds Timer value (the output of the &lt;b&gt;Tick Count (ms)&lt;/b&gt; primitive) when the variable value was written.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">stats..write TS</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the time stamp (DBL representation), in the universal LabVIEW date/time format, when the variable value was written.</Property>
                </Item>
                <Item>
                  <Property Name="CtrlID">stats..write Cnt</Property>
                  <Property Name="CustomRule">TRUE</Property>
                  <Property Name="DscrMode">Custom</Property>
                  <Property Name="Description">indicates the variable write counter. This counter starts at zero (0) when the variable is created and increments every time the variable is written.</Property>
                </Item>
              </Property>
            </GroupRule>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Read Variables (ANY).vi"/>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Read Variables (DBL).vi"/>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Read Variables (STR).vi"/>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Write Variables (ANY).vi"/>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Write Variables (DBL).vi"/>
            <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Write Variables (STR).vi"/>
          </Item>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 1D Array of CDB.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 1D Array of DBL.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 1D Array of Strings.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 2D Array of CDB.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 2D Array of DBL.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - 2D Array of Strings.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Arbitrary Data.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - CDB Scalar.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - DBL Scalar.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - String.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\VarMan.llb\VM3 - Variable Data Info.vi"/>
        </Item>
        <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Menus\vm-top.mnu"/>
      </Item>
    </Item>
    <Item Type="File" URL="..\vi.lib\addons\CalcExpress\dir.mnu"/>
  </ProjectFiles>

