    <Item Name="VIs" Type="Group">
      <GroupRule/>
      <Item Name="CalcExpress" Type="Group">
        <GroupRule>
          <Property Name="Target_Paths.HTML_Dir">.</Property>
          <Property Name="Control_Rules">
            <Item>
              <Property Name="CtrlID">CE InstanceRef</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">is a reference number for a CalcExpress instance that contains a parsed CalcExpress expression/script. &lt;a href="hprj:[ce] CalcExpress - Parse Script.vi"&gt;CalcExpress - Parse Script.vi&lt;/a&gt; returns a value that can be wired directly to this terminal.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">dup CE InstanceRef</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;CE InstanceRef&lt;/b&gt;.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">VC Handle</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">is a handle of a variable context. CalcExpress accesses variables with this handle. You have to pass a valid handle to this terminal if variables are used in a script; otherwise, you can keep it unwired. Use &lt;a href="hprj:VM - Open Context.vi"&gt;VM - Open Context.vi&lt;/a&gt; to open a variable context.</Property>
            </Item>
            <Item>
              <Property Name="CtrlID">expression</Property>
              <Property Name="CustomRule">TRUE</Property>
              <Property Name="DscrMode">Custom</Property>
              <Property Name="Description">should contain an expression/script is to be parsed. See &lt;a href="hprj:ce_syntax.html"&gt;CalcExpress Script Syntax&lt;/a&gt; for more information.</Property>
            </Item>
          </Property>
        </GroupRule>
        <Item Name="CE Core" Type="Group">
          <GroupRule>
            <Property Name="Control_Rules">
              <Item>
                <Property Name="CtrlID">repeat (1)</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">specifies number of times the VI has to evaluate a script. If it is greater than zero, the VI evaluates the script the specified number of times, and returns result of the last evaluation. If it is equal to or less than zero, the VI does not perform an evaluation. By default, &lt;b&gt;repeat&lt;/b&gt; is equal to one (1).</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">params</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">cluster specifies optional parameters that influence on evaluation.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">params.autoVar</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">parameter enables (TRUE) or disables (FALSE) automatic (implicit) creating variables during an evaluation. If a left-hand operand in an Assignment operator is an identifier that does not refer to an existing variable, CalcExpress creates a variable with the such name to perform an assignment if only &lt;b&gt;autoVar&lt;/b&gt; is TRUE; otherwise an error is produced. Note that variables are created in a local variable context specified by &lt;b&gt;VC Handle&lt;/b&gt;. By default, &lt;b&gt;autoVar&lt;/b&gt; is TRUE.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">params.enCpx</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">parameter enables (TRUE) or disables (FALSE) performing operators on operands of &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;Complex data types&lt;/a&gt; (suppress polymorphism feature). By default, &lt;b&gt;enCpx&lt;/b&gt; is TRUE.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">directives</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">defines parsing directives:</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">directives.enaNamedConst</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">enables (TRUE) or disables (FALSE) treating &lt;a href="hprj:ce_syntax_misc.html#ce_syntax_namedconst"&gt;Named Constants&lt;/a&gt; during script parsing. This behavior can be altered during the parsing phase by using the &lt;b&gt;$NCON&lt;/b&gt; (enable) and &lt;b&gt;$NCOFF&lt;/b&gt; (disable) &lt;a href="hprj:directives.html"&gt;Parsing Directives&lt;/a&gt; directly within the script.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">numeric value</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">returns value of an expression if it has &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;DBL Number&lt;/a&gt; data type; otherwise it is not defined.\nNOTICE: the VI returns value of an expression but not an &lt;a href="hprj:ce_syntax_op_punctuator.html#ce_op_semicolon"&gt;expression-statement&lt;/a&gt;, which does not have a value. Don't put a semicolon after the last expression in a script if you need to obtain its value through this indicator.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">string value</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">returns value of an expression if it has &lt;a href="hprj:dtypes.html#data_types_predefined"&gt;String&lt;/a&gt; data type; otherwise it is not defined.\nNOTICE: the VI returns value of an expression but not an &lt;a href="hprj:ce_syntax_op_punctuator.html#ce_op_semicolon"&gt;expression-statement&lt;/a&gt;, which does not have a value. Don't put a semicolon after the last expression in a script if you need to obtain its value through this indicator.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">value type</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">returns datatype of expression value as enum. If a processed script does not contain an expression that produces a value (it is empty or consists of only &lt;a href="hprj:ce_syntax_op_punctuator.html#ce_op_semicolon"&gt;expression-statements&lt;/a&gt;), &lt;b&gt;value type&lt;/b&gt; is &lt;i&gt;DBL Number&lt;/i&gt;.\n&lt;a href="hprj:dtypes.html"&gt;Click here&lt;/a&gt; for more information on data types.\n</Property>
                <Property Name="EnumValDscr">
                  <EnumValue ID="0" STR="String"/>
                  <EnumValue ID="1" STR="DBL Number"/>
                  <EnumValue ID="2" STR="identifier"/>
                  <EnumValue ID="3" STR="1D Array of DBL"/>
                  <EnumValue ID="4" STR="2D Array of DBL"/>
                  <EnumValue ID="5" STR="CDB Number"/>
                  <EnumValue ID="6" STR="1D Array of CDB"/>
                  <EnumValue ID="7" STR="2D Array of CDB"/>
                  <EnumValue ID="8" STR="1D Array of String"/>
                  <EnumValue ID="9" STR="2D Array of String"/>
                  <EnumValue ID="10" STR="Unknown data type"/>
                </Property>
              </Item>
              <Item>
                <Property Name="CtrlID">Array of func names</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">defines an array of function names to load/unload respective FuncVIs. If the array is not empty, every element of the array has to contain a function name (not a FuncVI name). If &lt;b&gt;Array of func names&lt;/b&gt; is empty (by default), the VI uses &lt;b&gt;List of func names&lt;/b&gt; as the source of function names.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">List of func names</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">defines a list of function names to load/unload respective FuncVIs if &lt;b&gt;Array of func names&lt;/b&gt; is not wired or is empty. Every line of the list has to contain a function name (not a FuncVI name).</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">loaded functions</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">returns function names whose FuncVIs have been loaded at the current call of the VI. Note that VI only loads FuncVIs that are not loaded yet (more precise, FuncVIs to which CalcExpress doesn't have opened VI Reference).</Property>
              </Item>
            </Property>
          </GroupRule>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Abort Evaluation.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Close Instance.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Diagnose Script.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Eval Script.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Not a CE InstanceRef.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Parse Script.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress - Variables Writer ID.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress Light.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\calcexp.llb\[ce] CalcExpress.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - FuncVI search paths.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Load Functions.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Unload Functions.vi"/>
        </Item>
        <Item Name="Func VIs" Type="Group">
          <GroupRule>
            <Property Name="Control_Rules">
              <Item>
                <Property Name="CtrlID">Error Cluster out</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">indicates an error condition in the standard error cluster. This output provides &lt;B&gt;standard error out&lt;/B&gt; functionality. </Property>
              </Item>
              <Item>
                <Property Name="CtrlID">Error Cluster out.status</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">indicates error status.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">Error Cluster out.code</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains error code.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">Error Cluster out.source</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains additional error information.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">error status out</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">indicates an output error status.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">InstanceRef</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">is the reference to the CalcExpress instance that evaluates a CalcExpress expression.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">dup InstanceRef</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">is a flow-through parameter with the same value as &lt;b&gt;InstanceRef&lt;/b&gt;.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">error in</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">specifies an error status before this VI executes. The VI runs normally only if &lt;b&gt;error in&lt;/b&gt; is FALSE.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">error out</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">returns TRUE if either &lt;b&gt;error in&lt;/b&gt; is TRUE or the VI detects an error condition. If an error detected, the VI puts an error description to the &lt;a href="hprj:ce_funcvi.html#ce_quick_error_protocol"&gt;Error Protocol&lt;/a&gt;.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">Gen CE error?</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">If TRUE, the VI produces a CalcExpress error if &lt;b&gt;LabVIEW error code&lt;/b&gt; is non-zero. By default, it is FALSE.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">arg idx</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">is a zero-based index of element in &lt;b&gt;arg list&lt;/b&gt; is to be evaluated. Typically, if &lt;b&gt;arg list&lt;/b&gt; contains all function arguments, it specifies argument index in a function call. By default, &lt;b&gt;arg idx&lt;/b&gt; is equal to 0.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">arg list</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">array specifies a list of function arguments. Wire this terminal to respective control on a block diagram of a FuncVI in order to provide the VI with access to all arguments passed to a FuncVI. &lt;a href="hprj:ce_funcvi.html#ce_funcvi_args"&gt;Click here&lt;/a&gt; for more information.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">arg list..type</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains a code of the argument data type. Refer to the &lt;a href="hprj:dtypes.html"&gt;Data Types&lt;/a&gt; topic for details.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">arg list..str</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains either a string value of an argument or a name of variable if &lt;b&gt;type&lt;/b&gt; is equal to 2 (Identifier). &lt;b&gt;str&lt;/b&gt; is empty string if &lt;b&gt;type&lt;/b&gt; equals 1 (DBL Number). If an argument has either one of Complex data types or a user-defined data type, &lt;b&gt;str&lt;/b&gt; contains a value in the Flattened-To-String format.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">arg list..num</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">contains numeric value of an argument if it has DBL Number data type.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">min arg num</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Typically, if &lt;b&gt;arg list&lt;/b&gt; contains all function arguments, it specifies a minimum number of arguments that can be operated by a function. If the size of &lt;b&gt;arg list&lt;/b&gt; is less than a value of this control, the VI produces an error. By default, &lt;b&gt;min arg num&lt;/b&gt; is equal to 1.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">max arg num</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">Typically, if &lt;b&gt;arg list&lt;/b&gt; contains all function arguments, it specifies a maximum number of arguments that can be operated by a function. If the size of &lt;b&gt;arg list&lt;/b&gt; is greater than a value of this control, the VI produces an error. By default, &lt;b&gt;max arg num&lt;/b&gt; is equal to 100.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">val list</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">The VI returns argument values through this indicator. If an argument is a variable name, the respective element of &lt;b&gt;val list&lt;/b&gt; contains a value of the variable. The size of &lt;b&gt;val list&lt;/b&gt; is the same as the size of &lt;b&gt;arg list&lt;/b&gt;.</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">num list</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">The VI returns DBL scalar values of arguments through this indicator. If an argument is a variable name, the respective element of &lt;b&gt;num list&lt;/b&gt; contains a value of the variable. The size of &lt;b&gt;num list&lt;/b&gt; is the same as the size of &lt;b&gt;arg list&lt;/b&gt;.\nAn element of &lt;b&gt;num list&lt;/b&gt; contains a valid value if only the respective element of &lt;b&gt;type list&lt;/b&gt; indicates the argument has DBL Number data type.\n</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">str list</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">The VI returns string values of arguments through this indicator. If an argument is a variable name, the respective element of &lt;b&gt;str list&lt;/b&gt; contains a value of the variable. The size of &lt;b&gt;str&lt;/b&gt; list is the same as the size of &lt;b&gt;arg list&lt;/b&gt;.\nAn element of &lt;b&gt;str list&lt;/b&gt; contains a valid value unless the respective element of &lt;b&gt;type list&lt;/b&gt; indicates the argument has DBL Number data type. If an argument has either one of Complex data types or a user-defined data type, its value is present in the Flattened-To-String format.\n</Property>
              </Item>
              <Item>
                <Property Name="CtrlID">type list</Property>
                <Property Name="CustomRule">TRUE</Property>
                <Property Name="DscrMode">Custom</Property>
                <Property Name="Description">The VI returns actual data type codes of arguments through this indicator. If an argument is a variable name, the respective element of &lt;b&gt;type list&lt;/b&gt; contains a data type of the variable. The size of &lt;b&gt;type list&lt;/b&gt; is the same as the size of &lt;b&gt;arg list&lt;/b&gt;. Refer to the &lt;a href="hprj:dtypes.html"&gt;Data Types&lt;/a&gt; topic for details.</Property>
              </Item>
            </Property>
          </GroupRule>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\ceBase.llb\Exp - Error handler.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\ceBase.llb\Exp - Get CalcExpress Error as Error Cluster.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\ceBase.llb\Exp - Get VC Handle.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Error Status to Error Cluster.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get argument.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get DBL argument as 1D Array.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get declared arguments.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - get function name_.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get list of arguments.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get list of numeric arguments.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Get list of string arguments.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - LV runtime error handler (Error Cluster).vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - LV runtime error handler_.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Unflatten Error Handler (Error Cluster).vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - Unflatten-From-String Error handler.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - VarMan Error Handler (Error Cluster).vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - VarMan Error handler.vi"/>
          <Item Type="File" URL="..\vi.lib\addons\CalcExpress\Funcsup.llb\Func - VarMan VI Error Cluster to Func Result Value.vi"/>
        </Item>
